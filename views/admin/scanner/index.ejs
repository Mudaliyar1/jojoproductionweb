<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0"><i class="fas fa-qrcode text-success me-2"></i>Staff Entry Ticket QR Scanner</h3>
        <p class="text-muted small m-0">Point your device camera at attendee ticket QR code to validate entry.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span id="scannerOnlineBadge" class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill">
            <i class="fas fa-wifi me-1"></i> ONLINE SCANNER
        </span>
    </div>
</div>

<div class="row g-4 justify-content-center">
    <!-- Camera Feed Column -->
    <div class="col-lg-6 col-xl-5">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 text-center">
            <h5 class="fw-bold text-dark mb-3"><i class="fas fa-camera me-2 text-primary"></i>Live Camera Feed</h5>

            <!-- Event Selector & Gate Config -->
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label fs-8 fw-bold text-muted mb-1">Gate Name</label>
                    <input type="text" id="gateInput" class="form-control form-control-sm rounded-3" value="Gate 1 - Main Entrance">
                </div>
                <div class="col-6">
                    <label class="form-label fs-8 fw-bold text-muted mb-1">Scanner Mode</label>
                    <select id="autoCheckinSelect" class="form-select form-select-sm rounded-3">
                        <option value="true" selected>Auto Check-In on Scan</option>
                        <option value="false">Manual Confirmation</option>
                    </select>
                </div>
            </div>

            <!-- Scanner Display Box -->
            <div id="qr-reader" class="rounded-4 overflow-hidden border bg-dark" style="min-height: 280px;"></div>

            <div class="mt-3 d-flex justify-content-center gap-2">
                <button id="btnStartScan" onclick="startScanner()" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold">
                    <i class="fas fa-play me-1"></i> Start Camera
                </button>
                <button id="btnStopScan" onclick="stopScanner()" class="btn btn-outline-danger btn-sm rounded-pill px-4 fw-bold" disabled>
                    <i class="fas fa-stop me-1"></i> Stop Camera
                </button>
            </div>
            
            <div class="mt-3">
                <label class="form-label fs-8 text-muted fw-bold">Or Manual Ticket Token Entry:</label>
                <div class="input-group input-group-sm">
                    <input type="text" id="manualTokenInput" class="form-control font-mono" placeholder="Paste ticket token or JJO-2026-XXXXXX">
                    <button class="btn btn-dark fw-bold" onclick="processScannedToken(document.getElementById('manualTokenInput').value)">Submit</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Scan Validation Result Screen -->
    <div class="col-lg-6 col-xl-7">
        <div id="scanResultContainer" class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100 d-flex flex-column justify-content-center align-items-center text-center">
            <div class="py-5">
                <div class="fs-1 text-muted mb-3"><i class="fas fa-barcode"></i></div>
                <h5 class="fw-bold text-dark mb-1">Ready for Ticket Scan</h5>
                <p class="text-muted small">Align the attendee's ticket QR code inside the camera box to verify access.</p>
            </div>
        </div>
    </div>
</div>

<!-- HTML5 QR Code Scanner CDN -->
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<script>
    let html5QrCode = null;
    let isScanning = false;
    let isProcessing = false;

    async function startScanner() {
        if (isScanning) return;
        const btnStart = document.getElementById('btnStartScan');
        const btnStop = document.getElementById('btnStopScan');
        btnStart.disabled = true;

        try {
            if (html5QrCode) {
                try { await html5QrCode.stop(); } catch(e) {}
                html5QrCode = null;
            }

            html5QrCode = new Html5Qrcode("qr-reader");
            const config = { fps: 10, qrbox: { width: 220, height: 220 } };

            try {
                await html5QrCode.start({ facingMode: "environment" }, config, onScanSuccess, onScanError);
            } catch(envErr) {
                console.warn("Back camera unavailable, trying default camera:", envErr);
                await html5QrCode.start({ facingMode: "user" }, config, onScanSuccess, onScanError);
            }

            isScanning = true;
            btnStart.disabled = true;
            btnStop.disabled = false;
        } catch (err) {
            console.error('Camera start error:', err);
            isScanning = false;
            btnStart.disabled = false;
            btnStop.disabled = true;
            alert('Unable to access camera: ' + (err.message || err));
        }
    }

    async function stopScanner() {
        if (!html5QrCode) return;
        const btnStart = document.getElementById('btnStartScan');
        const btnStop = document.getElementById('btnStopScan');

        try {
            await html5QrCode.stop();
        } catch (e) {}

        isScanning = false;
        html5QrCode = null;
        btnStart.disabled = false;
        btnStop.disabled = true;
    }

    function onScanSuccess(decodedText, decodedResult) {
        if (isProcessing) return;
        isProcessing = true;
        playBeepSound();
        processScannedToken(decodedText);
        setTimeout(() => { isProcessing = false; }, 2000);
    }

    function onScanError(error) {}

    async function processScannedToken(token) {
        if (!token) return;

        const gate = document.getElementById('gateInput').value || 'Main Entrance';
        const resultContainer = document.getElementById('scanResultContainer');

        resultContainer.innerHTML = `
            <div class="py-5">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <h5 class="fw-bold text-dark">Validating Pass...</h5>
            </div>
        `;

        if (!navigator.onLine) {
            renderOfflineError();
            return;
        }

        try {
            const res = await fetch('/admin/scanner/validate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ticketToken: token, gate, scannerDevice: 'Mobile Camera' })
            });

            const data = await res.json();
            renderScanResult(data);

        } catch (err) {
            renderOfflineError();
        }
    }

    function renderOfflineError() {
        renderScanResult({
            status: 'NO_INTERNET',
            title: 'NO INTERNET CONNECTION',
            message: 'Ticket verification requires an active internet connection. Please reconnect and try again.'
        });
    }

    function renderScanResult(data) {
        const container = document.getElementById('scanResultContainer');

        if (data.status === 'VALID') {
            container.innerHTML = `
                <div class="p-4 rounded-4 w-100 bg-success text-white">
                    <div class="fs-1 mb-2"><i class="fas fa-check-circle"></i></div>
                    <h2 class="fw-extrabold mb-1">${data.title}</h2>
                    <h5 class="fw-bold opacity-90 mb-3">${data.eventName}</h5>
                    
                    <div class="bg-white text-dark p-3 rounded-3 mb-3 text-start">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted fs-8">TICKET NUMBER:</span>
                            <span class="fw-extrabold font-mono text-primary">${data.ticketNumber}</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted fs-8">ATTENDEE NAME:</span>
                            <span class="fw-bold">${data.customerName}</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted fs-8">PASS TYPE:</span>
                            <span class="fw-bold">${data.ticketType || 'ENTRY TICKET'}</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted fs-8">VENUE:</span>
                            <span class="fw-bold">${data.venue}</span>
                        </div>
                    </div>

                    <div class="fs-7 fw-bold"><i class="fas fa-user-check me-1"></i> ENTRY CONFIRMED</div>
                </div>
            `;
        } else if (data.status === 'ALREADY_USED') {
            container.innerHTML = `
                <div class="p-4 rounded-4 w-100 bg-warning text-dark">
                    <div class="fs-1 mb-2"><i class="fas fa-exclamation-triangle"></i></div>
                    <h2 class="fw-extrabold mb-1">${data.title}</h2>
                    <h5 class="fw-bold mb-3">${data.eventName}</h5>

                    <div class="bg-white text-dark p-3 rounded-3 mb-3 text-start">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted fs-8">TICKET NUMBER:</span>
                            <span class="fw-extrabold font-mono">${data.ticketNumber}</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted fs-8">ATTENDEE NAME:</span>
                            <span class="fw-bold">${data.customerName}</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted fs-8">CHECKED IN AT:</span>
                            <span class="fw-bold text-danger">${data.checkedInAt}</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted fs-8">GATE:</span>
                            <span class="fw-bold">${data.gate}</span>
                        </div>
                    </div>

                    <div class="fs-7 fw-bold text-danger"><i class="fas fa-ban me-1"></i> DO NOT ADMIT AGAIN!</div>
                </div>
            `;
        } else {
            container.innerHTML = `
                <div class="p-4 rounded-4 w-100 bg-danger text-white">
                    <div class="fs-1 mb-2"><i class="fas fa-times-circle"></i></div>
                    <h2 class="fw-extrabold mb-2">${data.title}</h2>
                    <p class="fs-6 mb-3">${data.message}</p>
                    <div class="badge bg-white text-danger px-3 py-2 fw-bold">ENTRY DENIED</div>
                </div>
            `;
        }
    }

    function validateOffline(token, gate) {
        if (!db) {
            renderScanResult({ status: 'ERROR', title: '❌ OFFLINE ERROR', message: 'Offline database not ready.' });
            return;
        }

        const tx = db.transaction(['offlineCheckins'], 'readwrite');
        const store = tx.objectStore('offlineCheckins');

        const rec = {
            ticketToken: token,
            gate: gate,
            timestamp: new Date().toISOString()
        };

        store.add(rec);
        updateOfflineCountUI();

        renderScanResult({
            status: 'VALID',
            title: '✓ ENTRY RECORDED OFFLINE',
            eventName: 'Cached Event Pass',
            ticketNumber: token.slice(0, 12).toUpperCase(),
            customerName: 'Offline Attendee Pass',
            ticketType: 'ENTRY PASS',
            venue: 'Venue Checkpoint',
            message: 'Entry recorded in local device storage. Will auto-sync when online.'
        });
    }

    function updateOfflineCountUI() {
        if (!db) return;
        const tx = db.transaction(['offlineCheckins'], 'readonly');
        const store = tx.objectStore('offlineCheckins');
        const req = store.count();
        req.onsuccess = function() {
            const count = req.result;
            const btn = document.getElementById('btnSyncOffline');
            const cntSpan = document.getElementById('offlineCount');
            if (cntSpan) cntSpan.textContent = count;
            if (btn) {
                if (count > 0) btn.classList.remove('d-none');
                else btn.classList.add('d-none');
            }
        };
    }

    async function syncOfflineQueue() {
        if (!db || !navigator.onLine) return;

        const tx = db.transaction(['offlineCheckins'], 'readonly');
        const store = tx.objectStore('offlineCheckins');
        const req = store.getAll();

        req.onsuccess = async function() {
            const records = req.result;
            if (records.length === 0) return;

            try {
                const res = await fetch('/admin/scanner/sync-offline', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ offlineRecords: records })
                });
                const data = await res.json();
                if (data.success) {
                    // Clear synced records
                    const clearTx = db.transaction(['offlineCheckins'], 'readwrite');
                    clearTx.objectStore('offlineCheckins').clear();
                    updateOfflineCountUI();
                    alert(`Successfully synced ${data.syncedCount} offline ticket entry records!`);
                }
            } catch (err) {
                alert('Sync failed. Will retry when connection stabilizes.');
            }
        };
    }

    window.addEventListener('online', function() {
        const badge = document.getElementById('scannerOnlineBadge');
        if (badge) badge.className = 'badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill';
        syncOfflineQueue();
    });

    window.addEventListener('offline', function() {
        const badge = document.getElementById('scannerOnlineBadge');
        if (badge) badge.className = 'badge bg-warning-subtle text-warning border border-warning px-3 py-2 rounded-pill';
    });

    function playBeepSound() {
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = ctx.createOscillator();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(880, ctx.currentTime);
            osc.connect(ctx.destination);
            osc.start();
            osc.stop(ctx.currentTime + 0.15);
        } catch (e) {}
    }
</script>

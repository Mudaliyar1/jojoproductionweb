<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0"><i class="fas fa-history text-primary me-2"></i>Entry Logs & Check-In History</h3>
        <p class="text-muted small m-0">Event: <strong class="text-dark"><%= event.name %></strong> • Audit real-time gate entry logs and scan history.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/admin/events/<%= event._id %>/scanners" class="btn btn-outline-primary rounded-3 fw-bold">
            <i class="fas fa-qrcode me-1"></i> Manage Scanner Links
        </a>
        <a href="/admin/events/<%= event._id %>/settings" class="btn btn-outline-secondary rounded-3 fw-bold">
            <i class="fas fa-arrow-left me-1"></i> Back to Settings
        </a>
    </div>
</div>

<!-- Search & Filter Controls -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
    <form action="/admin/events/<%= event._id %>/entry-logs" method="GET" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="position-relative">
                <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                <input type="text" name="search" class="form-control ps-5 rounded-3" placeholder="Search ticket #, attendee, gate name..." value="<%= searchQuery %>">
            </div>
        </div>

        <div class="col-md-3">
            <select name="scannerId" class="form-select rounded-3">
                <option value="">All Gate Scanners</option>
                <% scannerLinks.forEach(function(s) { %>
                    <option value="<%= s._id %>" <%= selectedScanner == s._id.toString() ? 'selected' : '' %>><%= s.name %></option>
                <% }); %>
            </select>
        </div>

        <div class="col-md-3">
            <select name="status" class="form-select rounded-3">
                <option value="">All Entry Statuses</option>
                <option value="APPROVED" <%= selectedStatus === 'APPROVED' ? 'selected' : '' %>>✓ APPROVED</option>
                <option value="ALREADY_CHECKED_IN" <%= selectedStatus === 'ALREADY_CHECKED_IN' ? 'selected' : '' %>>⚠ ALREADY CHECKED IN</option>
                <option value="WRONG_EVENT" <%= selectedStatus === 'WRONG_EVENT' ? 'selected' : '' %>>✕ WRONG EVENT</option>
            </select>
        </div>

        <div class="col-md-1">
            <button type="submit" class="btn btn-primary w-100 rounded-3"><i class="fas fa-filter"></i></button>
        </div>
    </form>
</div>

<!-- Entry Logs Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted fs-8 text-uppercase fw-bold border-top">
                <tr>
                    <th class="ps-4">Timestamp</th>
                    <th>Ticket Number</th>
                    <th>Attendee Name</th>
                    <th>Gate / Scanner</th>
                    <th>Status Result</th>
                    <th>Device Info</th>
                </tr>
            </thead>
            <tbody>
                <% if (entries && entries.length > 0) { %>
                    <% entries.forEach(function(e) { %>
                        <tr>
                            <td class="ps-4 text-muted fs-8">
                                <div class="fw-bold text-dark"><%= formatISTTime(e.createdAt, { hour: '2-digit', minute: '2-digit', second: '2-digit' }) %> IST</div>
                                <div><%= formatISTDate(e.createdAt) %></div>
                            </td>

                            <td class="fw-extrabold font-mono text-dark">
                                <%= e.ticketNumber %>
                            </td>

                            <td class="fw-bold text-dark">
                                <%= e.customerName %>
                            </td>

                            <td>
                                <div class="fw-semibold text-dark"><%= e.scannerName || e.gate %></div>
                                <div class="fs-8 text-muted">Gate: <%= e.gate %></div>
                            </td>

                            <td>
                                <% if (e.status === 'APPROVED') { %>
                                    <span class="badge bg-success text-white px-3 py-1 rounded-pill"><i class="fas fa-check-circle me-1"></i> APPROVED</span>
                                <% } else if (e.status === 'ALREADY_CHECKED_IN') { %>
                                    <span class="badge bg-warning text-dark px-3 py-1 rounded-pill"><i class="fas fa-exclamation-triangle me-1"></i> ALREADY USED</span>
                                <% } else if (e.status === 'WRONG_EVENT') { %>
                                    <span class="badge bg-danger text-white px-3 py-1 rounded-pill"><i class="fas fa-times-circle me-1"></i> WRONG EVENT</span>
                                <% } else { %>
                                    <span class="badge bg-secondary text-white px-3 py-1 rounded-pill"><%= e.status %></span>
                                <% } %>
                            </td>

                            <td class="text-muted fs-8">
                                <%= e.deviceInfo || 'Mobile Camera' %> <%= e.isOfflineRecord ? '(Offline Sync)' : '' %>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="fas fa-history fs-1 mb-3 text-muted"></i>
                            <h6 class="fw-bold">No entry log records match your filter</h6>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0"><i class="fas fa-qrcode text-success me-2"></i>Scanner Link Management</h3>
        <p class="text-muted small m-0">Event: <strong class="text-dark"><%= event.name %></strong> • Create dedicated public scanner links for bodyguards and gate security.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/admin/events/<%= event._id %>/entry-logs" class="btn btn-outline-dark rounded-3 fw-bold">
            <i class="fas fa-list-alt me-1"></i> View Entry Logs
        </a>
        <button type="button" class="btn btn-primary fw-bold shadow-sm rounded-3" data-bs-toggle="modal" data-bs-target="#createScannerModal">
            <i class="fas fa-plus-circle me-1"></i> Create Scanner Link
        </button>
        <a href="/admin/events/<%= event._id %>/settings" class="btn btn-outline-secondary rounded-3 fw-bold">
            <i class="fas fa-arrow-left me-1"></i> Back to Settings
        </a>
    </div>
</div>

<!-- Scanner Links Grid / List Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
    <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-0">
        <h5 class="fw-bold text-dark m-0">Active Gate Scanners for <%= event.name %></h5>
        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><%= scannerLinks.length %> Scanner Links Configured</span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted fs-8 text-uppercase fw-bold border-top">
                <tr>
                    <th class="ps-4">Scanner & Gate Name</th>
                    <th>Assigned Staff</th>
                    <th>Scans Overview</th>
                    <th>Wrong Event Rejected</th>
                    <th>Status</th>
                    <th>Last Active</th>
                    <th class="pe-4 text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (scannerLinks && scannerLinks.length > 0) { %>
                    <% scannerLinks.forEach(function(s) { %>
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-3 bg-success-subtle text-success p-2 text-center" style="width: 44px; height: 44px;">
                                        <i class="fas fa-mobile-alt fs-4"></i>
                                    </div>
                                    <div>
                                        <a href="<%= s.scannerUrl %>" target="_blank" class="fw-bold text-dark text-decoration-none hover-primary"><%= s.name %></a>
                                        <div class="fs-8 text-muted">Gate: <%= s.gateNumber || 'Main Gate' %></div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <% if (s.staffName) { %>
                                    <div class="fw-semibold text-dark"><%= s.staffName %></div>
                                    <div class="fs-8 text-muted"><%= s.staffPhone %></div>
                                <% } else { %>
                                    <span class="text-muted fs-8">General Security Link</span>
                                <% } %>
                            </td>

                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-success-subtle text-success border border-success font-mono"><%= s.successfulEntries %> Passed</span>
                                    <span class="badge bg-danger-subtle text-danger border border-danger font-mono"><%= s.rejectedEntries %> Rejected</span>
                                </div>
                                <div class="fs-8 text-muted mt-1"><%= s.alreadyCheckedInScans %> Duplicate Scans Blocked</div>
                            </td>

                            <td>
                                <% if (s.wrongEventScans > 0) { %>
                                    <span class="badge bg-danger text-white px-2 py-1"><i class="fas fa-hand-paper me-1"></i> <%= s.wrongEventScans %> Blocked</span>
                                <% } else { %>
                                    <span class="text-muted fs-8">0 Cross-Event Scans</span>
                                <% } %>
                            </td>

                            <td>
                                <% if (s.status === 'ACTIVE') { %>
                                    <span class="badge bg-success text-white px-3 py-1 rounded-pill">ACTIVE</span>
                                <% } else { %>
                                    <span class="badge bg-secondary text-white px-3 py-1 rounded-pill">DISABLED</span>
                                <% } %>
                            </td>

                            <td>
                                <div class="fs-8 text-muted">
                                    <%= s.lastActiveTime ? formatISTTime(s.lastActiveTime) + ' IST' : 'Never' %>
                                </div>
                            </td>

                            <td class="pe-4 text-end">
                                <div class="btn-group">
                                    <a href="<%= s.scannerUrl %>" target="_blank" class="btn btn-sm btn-outline-primary" title="Open Public Scanner Page">
                                        <i class="fas fa-external-link-alt"></i> Open
                                    </a>
                                    <button onclick="copyToClipboard('<%= s.scannerUrl %>')" class="btn btn-sm btn-outline-secondary" title="Copy Link">
                                        <i class="fas fa-copy"></i>
                                    </button>
                                    <a href="/admin/scanners/<%= s._id %>/poster" target="_blank" class="btn btn-sm btn-outline-dark" title="Print Poster QR">
                                        <i class="fas fa-qrcode"></i> Poster QR
                                    </a>
                                    <button onclick="toggleScanner('<%= s._id %>')" class="btn btn-sm <%= s.status === 'ACTIVE' ? 'btn-outline-warning' : 'btn-outline-success' %>" title="Toggle Active/Disable">
                                        <i class="fas <%= s.status === 'ACTIVE' ? 'fa-pause' : 'fa-play' %>"></i>
                                    </button>
                                    <button onclick="deleteScanner('<%= s._id %>')" class="btn btn-sm btn-outline-danger" title="Delete Link">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <i class="fas fa-qrcode text-muted fs-1 mb-3"></i>
                            <h5 class="fw-bold text-dark">No Scanner Links Created Yet</h5>
                            <p class="text-muted small">Create dedicated scanner links for Gate 1, VIP Entrance, or security teams.</p>
                            <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold" data-bs-toggle="modal" data-bs-target="#createScannerModal">
                                + Create First Scanner Link
                            </button>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Create Scanner Link -->
<div class="modal fade" id="createScannerModal" tabindex="-1" aria-labelledby="createScannerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white py-3 px-4 rounded-top-4">
                <h5 class="modal-title fw-bold" id="createScannerModalLabel"><i class="fas fa-plus-circle me-2"></i>Create Gate Scanner Link</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <form action="/admin/events/<%= event._id %>/scanners/create" method="POST">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label for="name" class="form-label fw-bold">Scanner / Gate Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control rounded-3" id="name" name="name" placeholder="e.g. Gate 1, VIP Entrance, Main Gate" required>
                    </div>

                    <div class="mb-3">
                        <label for="gateNumber" class="form-label fw-bold">Gate Number / Designation</label>
                        <input type="text" class="form-control rounded-3" id="gateNumber" name="gateNumber" placeholder="e.g. Gate A1">
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label for="staffName" class="form-label fw-bold fs-7">Staff / Bodyguard Name</label>
                            <input type="text" class="form-control rounded-3" id="staffName" name="staffName" placeholder="e.g. Vikram Singh">
                        </div>
                        <div class="col-6">
                            <label for="staffPhone" class="form-label fw-bold fs-7">Staff Phone</label>
                            <input type="tel" class="form-control rounded-3" id="staffPhone" name="staffPhone" placeholder="Mobile #">
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label for="validFrom" class="form-label fw-bold fs-7">Valid From (Optional)</label>
                            <input type="datetime-local" class="form-control rounded-3" id="validFrom" name="validFrom">
                        </div>
                        <div class="col-6">
                            <label for="validUntil" class="form-label fw-bold fs-7">Valid Until (Optional)</label>
                            <input type="datetime-local" class="form-control rounded-3" id="validUntil" name="validUntil">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="status" class="form-label fw-bold">Initial Status</label>
                        <select class="form-select rounded-3" id="status" name="status">
                            <option value="ACTIVE" selected>ACTIVE (Ready to Scan)</option>
                            <option value="DISABLED">DISABLED (Paused)</option>
                        </select>
                    </div>
                </div>

                <div class="modal-footer bg-light border-0 py-3 px-4 rounded-bottom-4">
                    <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-3 fw-bold px-4">Generate Link & QR</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function copyToClipboard(text) {
        navigator.clipboard.writeText(text);
        alert('Scanner URL copied to clipboard!');
    }

    async function toggleScanner(scannerId) {
        try {
            const res = await fetch(`/admin/scanners/${scannerId}/toggle`, { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                window.location.reload();
            } else {
                alert(data.message);
            }
        } catch (err) {
            alert('Failed to toggle scanner.');
        }
    }

    async function deleteScanner(scannerId) {
        if (!confirm('Are you sure you want to delete this scanner link?')) return;
        try {
            const res = await fetch(`/admin/scanners/${scannerId}`, { method: 'DELETE' });
            const data = await res.json();
            if (data.success) {
                window.location.reload();
            } else {
                alert(data.message);
            }
        } catch (err) {
            alert('Failed to delete scanner.');
        }
    }
</script>

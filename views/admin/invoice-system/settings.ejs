<form method="POST" action="/admin/invoice-system/settings/save" enctype="multipart/form-data" class="row g-4">
    <!-- Company Information -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="mb-0 fw-bold text-primary"><i class="fas fa-building me-2"></i>Company Details</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Company Name</label>
                        <input type="text" name="companyName" class="form-control" value="<%= settings.companyName %>">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tagline</label>
                        <input type="text" name="tagline" class="form-control" value="<%= settings.tagline %>">
                    </div>
                    <div class="col-12">
                        <label class="form-label">Upload Company Logo (Cloudinary Direct Storage)</label>
                        <input type="file" name="logoFile" accept="image/*" class="form-control mb-2">
                        <% if (settings.logoUrl) { %>
                            <div class="d-flex align-items-center gap-3 p-2 bg-light rounded border">
                                <img src="<%= settings.logoUrl %>" alt="Current Logo" style="max-height: 45px;" class="rounded">
                                <div class="small text-muted text-truncate">Current: <%= settings.logoUrl %></div>
                            </div>
                        <% } %>
                        <input type="hidden" name="logoUrl" value="<%= settings.logoUrl %>">
                        <div class="row g-2 mt-2">
                            <div class="col-md-6">
                                <label class="form-label fs-8 fw-bold">Logo Display Height (px)</label>
                                <input type="number" name="logoSize" class="form-control form-control-sm" value="<%= settings.logoSize || 75 %>" min="30" max="250" placeholder="e.g. 75">
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Address</label>
                        <textarea name="address" class="form-control" rows="2"><%= settings.address %></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Phone Number</label>
                        <input type="text" name="phone" class="form-control" value="<%= settings.phone %>">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Email Address</label>
                        <input type="email" name="email" class="form-control" value="<%= settings.email %>">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Website</label>
                        <input type="text" name="website" class="form-control" value="<%= settings.website %>">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Instagram Handle</label>
                        <input type="text" name="instagram" class="form-control" value="<%= settings.instagram %>">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">GST Number</label>
                        <input type="text" name="gstNumber" class="form-control" value="<%= settings.gstNumber %>">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">PAN Number</label>
                        <input type="text" name="panNumber" class="form-control" value="<%= settings.panNumber %>">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Banking, UPI & Signatures -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="mb-0 fw-bold text-success"><i class="fas fa-university me-2"></i>Banking, UPI & Signatures</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Bank Name</label>
                        <input type="text" name="bankName" class="form-control" value="<%= settings.bankName %>">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Account Number</label>
                        <input type="text" name="accountNumber" class="form-control" value="<%= settings.accountNumber %>">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">IFSC Code</label>
                        <input type="text" name="ifscCode" class="form-control" value="<%= settings.ifscCode %>">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Branch Name</label>
                        <input type="text" name="branchName" class="form-control" value="<%= settings.branchName %>">
                    </div>
                    <div class="col-12">
                        <label class="form-label">UPI ID (For Auto QR Code Generation)</label>
                        <input type="text" name="upiId" class="form-control fw-bold text-success" value="<%= settings.upiId %>" placeholder="username@upi">
                    </div>
                    <div class="col-12">
                        <label class="form-label">Authorized Signature Image URL</label>
                        <input type="text" name="signatureUrl" class="form-control" value="<%= settings.signatureUrl %>">
                    </div>
                    <hr class="my-2">
                    <h6 class="fw-bold text-dark mb-0">Document Numbering Prefixes</h6>
                    <div class="col-md-3">
                        <label class="form-label">Est Prefix</label>
                        <input type="text" name="estimatePrefix" class="form-control" value="<%= settings.estimatePrefix %>">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Next Est #</label>
                        <input type="number" name="nextEstimateNum" class="form-control" value="<%= settings.nextEstimateNum %>">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Inv Prefix</label>
                        <input type="text" name="invoicePrefix" class="form-control" value="<%= settings.invoicePrefix %>">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Next Inv #</label>
                        <input type="number" name="nextInvoiceNum" class="form-control" value="<%= settings.nextInvoiceNum %>">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Default Notes & Terms -->
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-file-contract me-2"></i>Default Notes & Terms</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Default Client Notes</label>
                        <textarea name="defaultNotes" class="form-control" rows="4"><%= settings.defaultNotes %></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Default Terms & Conditions</label>
                        <textarea name="defaultTerms" class="form-control" rows="4"><%= settings.defaultTerms %></textarea>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white py-3 border-0 text-end">
                <button type="submit" class="btn btn-primary px-4"><i class="fas fa-save me-1"></i>Save System Settings</button>
            </div>
        </div>
    </div>
</form>

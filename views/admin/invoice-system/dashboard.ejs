<!-- Dashboard Header -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark">Invoice & Financial Dashboard</h3>
        <p class="text-muted fs-7 mb-0">Overview of estimates, invoices, collections, and client activity.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/admin/invoice-system/estimates/create" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>New Estimate
        </a>
        <a href="/admin/invoice-system/invoices/create" class="btn btn-outline-primary">
            <i class="fas fa-plus me-1"></i>New Invoice
        </a>
    </div>
</div>

<!-- Primary Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card card-hover border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-uppercase fs-8 fw-bold text-muted">Total Estimates</span>
                    <div class="p-2 rounded-3 bg-primary-subtle text-primary">
                        <i class="fas fa-calculator fa-lg"></i>
                    </div>
                </div>
                <h2 class="fw-bold mb-2 text-dark"><%= stats.totalEstimates %></h2>
                <div class="d-flex gap-2 fs-8">
                    <span class="badge bg-light text-secondary border"><%= stats.draftEstimates %> Drafts</span>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle"><%= stats.pendingEstimates %> Pending</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card card-hover border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-uppercase fs-8 fw-bold text-muted">Approved & Converted</span>
                    <div class="p-2 rounded-3 bg-success-subtle text-success">
                        <i class="fas fa-check-circle fa-lg"></i>
                    </div>
                </div>
                <h2 class="fw-bold mb-2 text-dark"><%= stats.approvedEstimates + stats.convertedInvoices %></h2>
                <div class="d-flex gap-2 fs-8">
                    <span class="badge bg-success-subtle text-success border border-success-subtle"><%= stats.approvedEstimates %> Approved</span>
                    <span class="badge bg-info-subtle text-info border border-info-subtle"><%= stats.convertedInvoices %> Converted</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card card-hover border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-uppercase fs-8 fw-bold text-muted">Paid Invoices</span>
                    <div class="p-2 rounded-3 bg-info-subtle text-info">
                        <i class="fas fa-file-invoice-dollar fa-lg"></i>
                    </div>
                </div>
                <h2 class="fw-bold mb-2 text-dark"><%= stats.paidInvoices %></h2>
                <div class="fs-8 text-muted">
                    Monthly Revenue: <strong class="text-success">₹<%= stats.monthlyRevenue.toLocaleString('en-IN') %></strong>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card card-hover border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-uppercase fs-8 fw-bold text-muted">Pending Balance</span>
                    <div class="p-2 rounded-3 bg-danger-subtle text-danger">
                        <i class="fas fa-exclamation-triangle fa-lg"></i>
                    </div>
                </div>
                <h2 class="fw-bold mb-2 text-danger">₹<%= stats.pendingPayments.toLocaleString('en-IN') %></h2>
                <div class="fs-8 text-muted">
                    Today's Revenue: <strong class="text-dark">₹<%= stats.todayRevenue.toLocaleString('en-IN') %></strong>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Managed Clients & Events Bar -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-primary-subtle text-primary rounded-3">
                        <i class="fas fa-address-book fa-2x"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark"><%= stats.totalClients %></h4>
                        <span class="text-muted fs-7">Active CRM Clients</span>
                    </div>
                </div>
                <a href="/admin/invoice-system/clients" class="btn btn-sm btn-outline-primary">Manage Directory</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-warning-subtle text-warning rounded-3">
                        <i class="fas fa-calendar-star fa-2x"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark"><%= stats.upcomingEventsCount %></h4>
                        <span class="text-muted fs-7">Upcoming Scheduled Events</span>
                    </div>
                </div>
                <a href="/admin/invoice-system/estimates/create" class="btn btn-sm btn-primary">Book New Event</a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Tables Stream -->
<div class="row g-4">
    <!-- Recent Estimates -->
    <div class="col-xl-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-0">
                <h6 class="fw-bold mb-0 text-dark"><i class="fas fa-calculator text-primary me-2"></i>Recent Estimates</h6>
                <a href="/admin/invoice-system/estimates" class="btn btn-sm btn-light border">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Est #</th>
                            <th>Client</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (recentEstimates && recentEstimates.length > 0) { %>
                            <% recentEstimates.forEach(est => { %>
                                <tr>
                                    <td>
                                        <a href="/admin/invoice-system/estimates/edit/<%= est._id %>" class="fw-bold text-primary text-decoration-none">
                                            <%= est.estimateNumber %>
                                        </a>
                                    </td>
                                    <td><%= est.client ? est.client.name : 'N/A' %></td>
                                    <td class="fw-semibold">₹<%= est.grandTotal.toLocaleString('en-IN') %></td>
                                    <td>
                                        <span class="badge bg-<%= est.status === 'Approved' ? 'success-subtle text-success' : est.status === 'Converted' ? 'info-subtle text-info' : 'secondary-subtle text-secondary' %>">
                                            <%= est.status %>
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a href="/admin/invoice-system/estimates/edit/<%= est._id %>" class="btn btn-sm btn-light border"><i class="fas fa-edit"></i></a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="5" class="text-center py-4 text-muted">No estimates created yet</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent Invoices -->
    <div class="col-xl-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-0">
                <h6 class="fw-bold mb-0 text-dark"><i class="fas fa-file-invoice-dollar text-success me-2"></i>Recent Invoices</h6>
                <a href="/admin/invoice-system/invoices" class="btn btn-sm btn-light border">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Inv #</th>
                            <th>Client</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (recentInvoices && recentInvoices.length > 0) { %>
                            <% recentInvoices.forEach(inv => { %>
                                <tr>
                                    <td>
                                        <a href="/admin/invoice-system/invoices/edit/<%= inv._id %>" class="fw-bold text-dark text-decoration-none">
                                            <%= inv.invoiceNumber %>
                                        </a>
                                    </td>
                                    <td><%= inv.client ? inv.client.name : 'N/A' %></td>
                                    <td class="fw-semibold">₹<%= inv.grandTotal.toLocaleString('en-IN') %></td>
                                    <td>
                                        <span class="badge bg-<%= inv.status === 'Paid' ? 'success-subtle text-success' : inv.status === 'Partially Paid' ? 'warning-subtle text-warning' : 'danger-subtle text-danger' %>">
                                            <%= inv.status %>
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a href="/admin/invoice-system/invoices/edit/<%= inv._id %>" class="btn btn-sm btn-light border"><i class="fas fa-edit"></i></a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="5" class="text-center py-4 text-muted">No invoices generated yet</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= doc.estimateNumber || doc.invoiceNumber %> - <%= doc.companyDetails.companyName || settings.companyName %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @page { size: A4 portrait; margin: 8mm 10mm; }
        body { background: #f8f9fa; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #222; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .page-a4 {
            width: 210mm;
            min-height: 297mm;
            padding: 15mm;
            margin: 20px auto;
            background: #ffffff;
            box-shadow: 0 0 15px rgba(0,0,0,0.1);
            position: relative;
            box-sizing: border-box;
        }
        .watermark-overlay {
            position: absolute;
            top: 40%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-35deg);
            font-size: 5rem;
            font-weight: 900;
            color: rgba(220, 53, 69, 0.12);
            text-transform: uppercase;
            pointer-events: none;
            user-select: none;
            letter-spacing: 10px;
        }
        @media print {
            @page { size: A4 portrait; margin: 8mm 10mm; }
            html, body { background: #ffffff !important; margin: 0 !important; padding: 0 !important; width: 100% !important; height: auto !important; }
            .page-a4 { margin: 0 auto !important; box-shadow: none !important; width: 100% !important; max-width: 100% !important; padding: 0 !important; min-height: auto !important; box-sizing: border-box !important; page-break-after: avoid !important; page-break-inside: avoid !important; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body>
    <!-- Top Action Bar for Screen view -->
    <div class="no-print bg-dark text-white py-2 px-4 d-flex justify-content-between align-items-center mb-3">
        <div>
            <span class="fw-bold"><%= docType.toUpperCase() %>: <%= doc.estimateNumber || doc.invoiceNumber %></span>
            <span class="badge bg-primary ms-2"><%= doc.status %></span>
        </div>
        <div>
            <button onclick="downloadPDF()" class="btn btn-primary btn-sm me-2"><i class="fas fa-file-pdf me-1"></i>Download PDF</button>
            <button onclick="window.print()" class="btn btn-success btn-sm me-2"><i class="fas fa-print me-1"></i>Print Document</button>
            <a href="/admin/invoice-system/<%= docType %>s/edit/<%= doc._id %>" class="btn btn-outline-light btn-sm"><i class="fas fa-edit me-1"></i>Back to Live Editor</a>
        </div>
    </div>

    <!-- Print Canvas A4 Page -->
    <div class="page-a4">
        <!-- Watermark -->
        <% if (doc.watermark && doc.watermark !== 'None') { %>
            <div class="watermark-overlay"><%= doc.watermark %></div>
        <% } %>

        <!-- Header -->
        <div class="row pb-4 mb-4 border-bottom align-items-center">
            <div class="col-7">
                <% const logoPath = (doc && doc.companyDetails && doc.companyDetails.logoUrl && doc.companyDetails.logoUrl.startsWith('http')) ? doc.companyDetails.logoUrl : (settings && settings.logoUrl ? settings.logoUrl : ''); %>
                <% const logoHeight = (settings && settings.logoSize) ? settings.logoSize : 75; %>
                <% if (logoPath) { %>
                    <img src="<%= logoPath %>" alt="Company Logo" height="<%= logoHeight %>" class="mb-2" crossorigin="anonymous" style="object-fit: contain;">
                <% } %>
                <h3 class="fw-bold mb-0" style="color: #1a252f;"><%= doc.companyDetails.companyName || settings.companyName %></h3>
                <div class="text-muted small"><%= doc.companyDetails.tagline || settings.tagline %></div>
                <div class="small mt-1 text-secondary">
                    <%= doc.companyDetails.address || settings.address %><br>
                    Phone: <%= doc.companyDetails.phone || settings.phone %> | Email: <%= doc.companyDetails.email || settings.email %><br>
                    <% if (doc.companyDetails.gstNumber || settings.gstNumber) { %>
                        <strong>GSTIN: <%= doc.companyDetails.gstNumber || settings.gstNumber %></strong>
                    <% } %>
                </div>
            </div>
            <div class="col-5 text-end">
                <h2 class="text-uppercase fw-bold mb-1" style="color: #2c3e50;"><%= docType === 'estimate' ? 'ESTIMATE' : 'INVOICE' %></h2>
                <h5 class="fw-bold text-primary mb-2"># <%= doc.estimateNumber || doc.invoiceNumber %></h5>
                <div class="small">
                    <strong>Date:</strong> <%= new Date(doc.estimateDate || doc.invoiceDate).toLocaleDateString('en-IN') %><br>
                    <% if (doc.expiryDate || doc.dueDate) { %>
                        <strong><%= docType === 'estimate' ? 'Valid Until:' : 'Due Date:' %></strong> <%= new Date(doc.expiryDate || doc.dueDate).toLocaleDateString('en-IN') %><br>
                    <% } %>
                    <% if (doc.salesPerson) { %>
                        <strong>Sales Representative:</strong> <%= doc.salesPerson %><br>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Client & Event Info -->
        <div class="row mb-4">
            <div class="col-6">
                <div class="p-3 bg-light rounded border">
                    <h6 class="fw-bold text-uppercase text-secondary mb-2" style="font-size: 0.8rem;">Billed To / Client Details</h6>
                    <h5 class="fw-bold mb-1 text-dark"><%= doc.client ? doc.client.name : 'N/A' %></h5>
                    <div class="small text-secondary">
                        <% if (doc.client && doc.client.address) { %><%= doc.client.address %><br><% } %>
                        Mobile: <%= doc.client ? doc.client.mobile : '' %><br>
                        <% if (doc.client && doc.client.email) { %>Email: <%= doc.client.email %><% } %>
                    </div>
                </div>
            </div>
            <div class="col-6">
                <div class="p-3 bg-light rounded border h-100">
                    <h6 class="fw-bold text-uppercase text-secondary mb-2" style="font-size: 0.8rem;">Event Details</h6>
                    <h5 class="fw-bold mb-1 text-primary"><%= doc.client ? doc.client.eventName || 'Event Production' : 'Event Production' %></h5>
                    <div class="small text-secondary">
                        <% if (doc.client && doc.client.eventDate) { %>
                            <strong>Event Date:</strong> <%= new Date(doc.client.eventDate).toLocaleDateString('en-IN') %><br>
                        <% } %>
                        <% if (doc.client && doc.client.venue) { %>
                            <strong>Venue:</strong> <%= doc.client.venue %>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Items Table -->
        <table class="table table-bordered align-middle mb-4">
            <thead style="background-color: #2c3e50; color: #ffffff;" class="text-uppercase small">
                <tr>
                    <th style="width: 5%;">#</th>
                    <th style="width: 40%;">Description / Service</th>
                    <th style="width: 10%;" class="text-center">Qty</th>
                    <th style="width: 15%;" class="text-end">Rate (₹)</th>
                    <th style="width: 10%;" class="text-center">GST %</th>
                    <th style="width: 20%;" class="text-end">Amount (₹)</th>
                </tr>
            </thead>
            <tbody>
                <% if (doc.items && doc.items.length > 0) { %>
                    <% doc.items.forEach((item, idx) => { %>
                        <tr>
                            <td class="text-center fw-bold"><%= idx + 1 %></td>
                            <td><%= item.description %></td>
                            <td class="text-center"><%= item.quantity %> <%= item.unit || '' %></td>
                            <td class="text-end">
                                <% if (item.priceType === 'range') { %>
                                    ₹<%= item.rate.toLocaleString('en-IN') %> - ₹<%= item.maxRate.toLocaleString('en-IN') %>
                                <% } else { %>
                                    ₹<%= item.rate.toLocaleString('en-IN') %>
                                <% } %>
                            </td>
                            <td class="text-center"><%= item.gstPercent %>%</td>
                            <td class="text-end fw-bold">
                                <% if (item.priceType === 'range') { %>
                                    ₹<%= item.amount.toLocaleString('en-IN') %> - ₹<%= item.maxAmount.toLocaleString('en-IN') %>
                                <% } else { %>
                                    ₹<%= item.amount.toLocaleString('en-IN') %>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>

        <!-- Summary & Totals -->
        <div class="row mb-4">
            <div class="col-7">
                <% if (upiQrUrl) { %>
                    <div class="p-3 border rounded bg-light d-flex align-items-center gap-3">
                        <img src="<%= upiQrUrl %>" alt="UPI QR Code" style="width: 100px; height: 100px;">
                        <div>
                            <h6 class="fw-bold mb-1 text-dark"><i class="fas fa-qrcode me-1 text-success"></i>Scan to Pay via UPI</h6>
                            <small class="text-muted d-block">UPI ID: <strong><%= doc.companyDetails.upiId || settings.upiId %></strong></small>
                            <small class="text-muted">Instant & Secure Direct Payment</small>
                        </div>
                    </div>
                <% } %>
            </div>
            <div class="col-5">
                <table class="table table-sm table-borderless text-end small">
                    <tr>
                        <td class="text-muted">Subtotal:</td>
                        <td class="fw-semibold">₹<%= doc.subtotal.toLocaleString('en-IN') %></td>
                    </tr>
                    <% if (doc.discountTotal > 0) { %>
                        <tr>
                            <td class="text-muted">Discount:</td>
                            <td class="text-danger">-₹<%= doc.discountTotal.toLocaleString('en-IN') %></td>
                        </tr>
                    <% } %>
                    <% if (doc.gstTotal > 0) { %>
                        <tr>
                            <td class="text-muted">GST Total:</td>
                            <td class="fw-semibold">₹<%= doc.gstTotal.toLocaleString('en-IN') %></td>
                        </tr>
                    <% } %>
                    <% if (doc.transportCharges > 0) { %>
                        <tr>
                            <td class="text-muted">Transport / Logistics:</td>
                            <td class="fw-semibold">₹<%= doc.transportCharges.toLocaleString('en-IN') %></td>
                        </tr>
                    <% } %>
                    <tr class="border-top border-bottom">
                        <td class="fw-bold fs-6">Grand Total:</td>
                        <td class="fw-bold fs-6 text-primary">
                            <% if (doc.minTotal && doc.maxTotal && doc.minTotal !== doc.maxTotal) { %>
                                ₹<%= doc.minTotal.toLocaleString('en-IN') %> - ₹<%= doc.maxTotal.toLocaleString('en-IN') %>
                            <% } else { %>
                                ₹<%= doc.grandTotal.toLocaleString('en-IN') %>
                            <% } %>
                        </td>
                    </tr>
                    <% if (doc.advancePaid > 0) { %>
                        <tr>
                            <td class="text-muted">Advance / Paid Amount:</td>
                            <td class="text-success fw-bold">₹<%= doc.advancePaid.toLocaleString('en-IN') %></td>
                        </tr>
                    <% } %>
                    <tr>
                        <td class="fw-bold">Balance Due:</td>
                        <td class="fw-bold text-danger fs-6">₹<%= doc.balanceDue.toLocaleString('en-IN') %></td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- Notes & Signature -->
        <div class="row pt-3 border-top mt-auto align-items-end">
            <div class="col-8">
                <div class="small text-secondary mb-2">
                    <strong>Notes:</strong> <%= doc.notes || settings.defaultNotes %>
                </div>
                <div class="small text-secondary">
                    <strong>Terms & Conditions:</strong><br>
                    <span style="white-space: pre-line;"><%= doc.terms || settings.defaultTerms %></span>
                </div>
            </div>
            <div class="col-4 text-end">
                <% if (doc.companyDetails.signatureUrl || settings.signatureUrl) { %>
                    <img src="<%= doc.companyDetails.signatureUrl || settings.signatureUrl %>" alt="Signature" style="max-height: 50px;" class="mb-1"><br>
                <% } %>
                <div class="border-top pt-1 text-center font-monospace small text-uppercase text-muted">
                    Authorized Signatory
                </div>
            </div>
        </div>
    </div>

    <script>
        function downloadPDF() {
            window.print();
        }

        document.addEventListener('DOMContentLoaded', function() {
            const params = new URLSearchParams(window.location.search);
            if (params.get('download') === 'pdf' || params.get('print') === 'true') {
                setTimeout(function() {
                    window.print();
                }, 350);
            }
        });
    </script>
</body>
</html>

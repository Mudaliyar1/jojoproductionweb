<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <form method="GET" action="/admin/invoice-system/services" class="d-flex gap-2 flex-grow-1 max-w-500">
                <div class="position-relative w-100">
                    <i class="fas fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                    <input type="text" name="search" class="form-control ps-5" placeholder="Search by service name, category..." value="<%= search %>">
                </div>
                <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i></button>
            </form>
            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#serviceModal" onclick="resetServiceForm()">
                <i class="fas fa-plus me-1"></i>Add Reusable Service
            </button>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 border-0">
        <h5 class="mb-0 fw-bold text-dark"><i class="fas fa-concierge-bell me-2 text-primary"></i>Services Catalog</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Service Name</th>
                    <th>Category</th>
                    <th>Price Structure</th>
                    <th>GST %</th>
                    <th>Unit</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (services && services.length > 0) { %>
                    <% services.forEach(s => { %>
                        <tr>
                            <td>
                                <div class="fw-bold text-dark"><%= s.name %></div>
                                <small class="text-muted"><%= s.description || '' %></small>
                            </td>
                            <td><span class="badge bg-light text-secondary border"><%= s.category %></span></td>
                            <td>
                                <% if (s.priceType === 'range') { %>
                                    <span class="fw-bold text-success">₹<%= s.defaultPrice.toLocaleString('en-IN') %> - ₹<%= (s.maxPrice || 0).toLocaleString('en-IN') %></span>
                                    <span class="badge bg-info-subtle text-info border border-info-subtle ms-1">Range</span>
                                <% } else { %>
                                    <span class="fw-bold text-dark">₹<%= s.defaultPrice.toLocaleString('en-IN') %></span>
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle ms-1">Fixed</span>
                                <% } %>
                            </td>
                            <td><%= s.gstPercent %>%</td>
                            <td><%= s.unit %></td>
                            <td>
                                <span class="badge bg-<%= s.status === 'active' ? 'success-subtle text-success' : 'danger-subtle text-danger' %>">
                                    <%= s.status %>
                                </span>
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-primary" data-service="<%= JSON.stringify(s) %>" onclick="onEditServiceClick(this)"><i class="fas fa-edit"></i></button>
                                <form method="POST" action="/admin/invoice-system/services/delete/<%= s._id %>" class="d-inline" onsubmit="return confirm('Delete this service?')">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="7" class="text-center py-5 text-muted">No services found in catalog</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Service Modal -->
<div class="modal fade" id="serviceModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <form method="POST" action="/admin/invoice-system/services/save" id="serviceForm">
                <input type="hidden" name="id" id="serviceId">
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold text-dark" id="serviceModalTitle">Add New Service</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label required">Service Name</label>
                        <input type="text" name="name" id="sName" class="form-control" placeholder="e.g. LED Wall, Sound System, DJ" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <input type="text" name="category" id="sCategory" class="form-control" placeholder="Production, Artist, SFX, Decor" value="Production">
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Price Type</label>
                            <select name="priceType" id="sPriceType" class="form-select" onchange="toggleMaxPriceField()">
                                <option value="fixed">Fixed Price</option>
                                <option value="range">Range Price (Min - Max)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Unit</label>
                            <input type="text" name="unit" id="sUnit" class="form-control" value="Event">
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label required">Default / Min Price (₹)</label>
                            <input type="number" step="0.01" name="defaultPrice" id="sDefaultPrice" class="form-control" required>
                        </div>
                        <div class="col-md-6" id="maxPriceContainer" style="display:none;">
                            <label class="form-label">Max Price (₹)</label>
                            <input type="number" step="0.01" name="maxPrice" id="sMaxPrice" class="form-control">
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">GST Rate (%)</label>
                            <input type="number" name="gstPercent" id="sGstPercent" class="form-control" value="18">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Status</label>
                            <select name="status" id="sStatus" class="form-select">
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="description" id="sDescription" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success px-4"><i class="fas fa-save me-1"></i>Save Service</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function onEditServiceClick(btn) {
    const s = JSON.parse(btn.dataset.service);
    editService(s);
}

function toggleMaxPriceField() {
    var type = document.getElementById('sPriceType').value;
    document.getElementById('maxPriceContainer').style.display = (type === 'range') ? 'block' : 'none';
}

function resetServiceForm() {
    document.getElementById('serviceForm').reset();
    document.getElementById('serviceId').value = '';
    document.getElementById('serviceModalTitle').innerText = 'Add New Service';
    toggleMaxPriceField();
}

function editService(s) {
    document.getElementById('serviceId').value = s._id || '';
    document.getElementById('sName').value = s.name || '';
    document.getElementById('sCategory').value = s.category || 'Production';
    document.getElementById('sPriceType').value = s.priceType || 'fixed';
    document.getElementById('sDefaultPrice').value = s.defaultPrice || 0;
    document.getElementById('sMaxPrice').value = s.maxPrice || 0;
    document.getElementById('sGstPercent').value = s.gstPercent || 18;
    document.getElementById('sUnit').value = s.unit || 'Event';
    document.getElementById('sStatus').value = s.status || 'active';
    document.getElementById('sDescription').value = s.description || '';
    document.getElementById('serviceModalTitle').innerText = 'Edit Service - ' + s.name;
    toggleMaxPriceField();
    var modal = new bootstrap.Modal(document.getElementById('serviceModal'));
    modal.show();
}
</script>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Booking Confirmed - <%= event.name %></title>
    
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Event Design System CSS -->
    <link rel="stylesheet" href="/css/event-design-system.css">

    <!-- html2pdf.js for Direct Client-Side PDF Downloads -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <style>
        body {
            background-color: var(--ds-bg);
            padding: 30px 16px;
        }

        .ticket-card-digital {
            background: #FFFFFF;
            border: 1px solid var(--ds-border);
            border-radius: var(--ds-radius-xl);
            overflow: hidden;
            box-shadow: var(--ds-shadow-md);
            max-width: 480px;
            margin: 0 auto 24px auto;
            position: relative;
            page-break-inside: avoid !important;
            break-inside: avoid !important;
        }

        .ticket-card-header {
            background-color: var(--ds-primary);
            color: #FFFFFF;
            padding: 20px 24px;
            text-align: center;
        }

        .ticket-divider {
            position: relative;
            height: 1px;
            border-top: 2px dashed var(--ds-border);
            margin: 0;
            background: transparent;
        }

        .ticket-divider::before, .ticket-divider::after {
            content: '';
            position: absolute;
            top: -12px;
            width: 24px;
            height: 24px;
            background-color: var(--ds-bg);
            border-radius: 50%;
        }

        .ticket-divider::before { left: -13px; border-right: 1px solid var(--ds-border); }
        .ticket-divider::after { right: -13px; border-left: 1px solid var(--ds-border); }

        .ticket-card-body {
            padding: 24px;
        }

        .ticket-meta-label {
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--ds-text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 2px;
        }

        .ticket-meta-val {
            font-size: 0.92rem;
            font-weight: 700;
            color: var(--ds-text-primary);
            word-break: break-word;
        }

        @media print {
            body { background: #FFFFFF; padding: 0; }
            .btn-print-hide { display: none !important; }
            .ticket-card-digital { box-shadow: none; border-color: #000; }
        }
    </style>
</head>
<body>

    <div id="ticketPassesContainer" class="container" style="max-width: 520px;">
        
        <!-- Header Banner -->
        <div class="text-center mb-4 btn-print-hide">
            <span class="ds-badge ds-badge-success mb-2">
                <i class="fas fa-check-circle me-1"></i> BOOKING CONFIRMED
            </span>
            <h1 class="ds-title-hero mb-1">You're All Set!</h1>
            <p class="ds-text-body">Show your ticket QR pass at the entrance for verification.</p>
        </div>

        <!-- Loop for Individual Digital Pass Cards -->
        <% tickets.forEach(function(t, idx) { %>
            <div id="ticketCard_<%= idx %>" class="ticket-card-digital">
                <!-- Top Card Confirmation Banner -->
                <div class="text-center py-3 px-4 bg-success-subtle border-bottom border-success-subtle">
                    <span class="badge bg-success text-white fw-bold px-3 py-1 rounded-pill mb-1">
                        <i class="fas fa-check-circle me-1"></i> BOOKING CONFIRMED
                    </span>
                    <h4 class="fw-extrabold text-dark m-0 fs-5">You're All Set!</h4>
                    <div class="fs-8 text-muted">Official Event Entry Pass</div>
                </div>

                <!-- Top Pass Header -->
                <div class="ticket-card-header">
                    <div class="ds-text-sm text-white-50 text-uppercase fw-bold tracking-wider mb-1">
                        Individual Pass <%= idx + 1 %> of <%= tickets.length %>
                    </div>
                    <div class="font-mono fw-extrabold fs-4 tracking-tight"><%= t.ticketNumber %></div>
                </div>

                <div class="ticket-card-body text-center">
                    <!-- Prominent Clean QR Code -->
                    <div class="ds-qr-container mb-3">
                        <img src="<%= t.qrDataUri %>" alt="Ticket QR Code" style="width: 220px; height: 220px; display: inline-block; max-width: 100%;" crossorigin="anonymous">
                    </div>

                    <div class="d-flex align-items-center justify-content-center gap-2 mb-4 btn-print-hide flex-wrap">
                        <div class="ds-text-sm fw-bold text-dark me-2">
                            <i class="fas fa-qrcode me-1"></i> Scan at venue entrance
                        </div>
                        <button id="btnDownloadCard_<%= idx %>" onclick="downloadTicketPDF('<%= t.ticketNumber %>', 'ticketCard_<%= idx %>', 'btnDownloadCard_<%= idx %>')" class="btn btn-sm btn-dark rounded-pill px-3 py-1 fw-bold shadow-sm">
                            <i class="fas fa-file-pdf me-1 text-danger"></i> Download PDF
                        </button>
                    </div>

                    <!-- Complete Ticket Details Grid -->
                    <div class="row g-3 text-start pt-3 border-top">
                        <div class="col-6">
                            <div class="ticket-meta-label">Event Name</div>
                            <div class="ticket-meta-val"><%= event.name %></div>
                        </div>
                        <div class="col-6">
                            <div class="ticket-meta-label">Attendee Name</div>
                            <div class="ticket-meta-val"><%= t.customerName %></div>
                        </div>
                        <div class="col-6">
                            <div class="ticket-meta-label">Mobile Number</div>
                            <div class="ticket-meta-val"><%= t.customerMobile %></div>
                        </div>
                        <div class="col-6">
                            <div class="ticket-meta-label">Event Date</div>
                            <div class="ticket-meta-val"><%= formatISTDate(event.eventDate) %></div>
                        </div>
                        <div class="col-6">
                            <div class="ticket-meta-label">Event Time</div>
                            <div class="ticket-meta-val"><%= event.eventTime %> IST</div>
                        </div>
                        <div class="col-6">
                            <div class="ticket-meta-label">Pass Quantity</div>
                            <div class="ticket-meta-val"><%= booking.quantity %> Ticket(s)</div>
                        </div>
                        <div class="col-6">
                            <div class="ticket-meta-label">Booked Date & Time</div>
                            <div class="ticket-meta-val"><%= formatISTDateTime(booking.createdAt) %> IST</div>
                        </div>
                        <div class="col-6">
                            <div class="ticket-meta-label">Payment Status</div>
                            <div class="ticket-meta-val text-success"><%= booking.unitPrice === 0 ? 'FREE ENTRY' : 'CONFIRMED (₹' + booking.totalAmount + ')' %></div>
                        </div>
                        <div class="col-12">
                            <div class="ticket-meta-label">Venue Location</div>
                            <div class="ticket-meta-val"><%= event.venue %></div>
                        </div>
                    </div>
                </div>

                <div class="ticket-divider"></div>

                <!-- Footer details -->
                <div class="px-4 py-3 bg-light d-flex justify-content-between align-items-center ds-text-sm">
                    <span><i class="fas fa-receipt me-1"></i> Booking ID: <strong><%= booking.bookingId %></strong></span>
                    <span>Pass Status: <strong class="<%= t.ticketStatus === 'CANCELLED' ? 'text-danger' : 'text-success' %>"><%= t.ticketStatus || 'VALID' %></strong></span>
                </div>

                <!-- Entry Instructions -->
                <div class="px-4 py-2 bg-light text-center border-top text-muted fs-8">
                    <i class="fas fa-shield-alt text-primary me-1"></i> Present this digital pass QR code at the entrance for verification.
                </div>
            </div>
        <% }); %>

        <!-- Print / PDF Download Action Buttons -->
        <div class="text-center btn-print-hide mb-4">
            <button id="btnMainDownloadPdf" onclick="downloadTicketPDF('<%= booking.bookingId %>', 'ticketPassesContainer', 'btnMainDownloadPdf')" class="ds-btn ds-btn-primary w-100 py-3 mb-2">
                <i class="fas fa-file-pdf me-2"></i> Download Digital Passes (PDF)
            </button>
            <div class="ds-text-sm text-muted">
                Click to directly save your ticket pass as a PDF file onto your device.
            </div>
        </div>
    </div>

    <!-- Direct PDF Download Engine Script -->
    <script>
        async function downloadTicketPDF(ticketNum, targetId, btnId) {
            const btn = document.getElementById(btnId);
            const originalHTML = btn ? btn.innerHTML : '';

            if (btn) {
                btn.disabled = true;
                btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1" role="status"></span> Generating PDF...`;
            }

            const originalElement = document.getElementById(targetId) || document.getElementById('ticketPassesContainer');
            if (!originalElement) return;

            // Clone element to prevent UI disruption or scroll clipping
            const clone = originalElement.cloneNode(true);
            
            // Remove all interactive action buttons in clone
            const hideElements = clone.querySelectorAll('.btn-print-hide');
            hideElements.forEach(el => el.remove());

            // Wrap clone in a clean off-screen container positioned at top-left
            const container = document.createElement('div');
            container.style.position = 'absolute';
            container.style.top = '-9999px';
            container.style.left = '0';
            container.style.width = '480px';
            container.style.backgroundColor = '#ffffff';
            container.style.padding = '10px';
            container.appendChild(clone);
            document.body.appendChild(container);

            const opt = {
                margin:       [8, 8, 8, 8],
                filename:     `Ticket-${ticketNum || 'Pass'}.pdf`,
                image:        { type: 'jpeg', quality: 1.0 },
                html2canvas:  { 
                    scale: 2, 
                    useCORS: true, 
                    allowTaint: true, 
                    backgroundColor: '#ffffff',
                    logging: false,
                    scrollY: 0,
                    scrollX: 0
                },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' },
                pagebreak:    { mode: ['avoid-all', 'css', 'legacy'] }
            };

            try {
                if (typeof html2pdf === 'function') {
                    await html2pdf().set(opt).from(clone).save();
                } else {
                    window.print();
                }
            } catch (err) {
                console.error('PDF download error:', err);
                window.print();
            } finally {
                if (document.body.contains(container)) {
                    document.body.removeChild(container);
                }
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalHTML;
                }
            }
        }
    </script>
</body>
</html>

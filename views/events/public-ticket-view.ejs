<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Booking Confirmed - <%= event.name %></title>
    
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Event Design System CSS -->
    <link rel="stylesheet" href="/css/event-design-system.css">

    <style>
        body {
            background-color: var(--ds-bg);
            padding: 30px 16px;
        }

        .ticket-card-digital {
            background: #FFFFFF;
            border: 1px solid var(--ds-border);
            border-radius: var(--ds-radius-xl);
            overflow: hidden;
            box-shadow: var(--ds-shadow-md);
            max-width: 480px;
            margin: 0 auto 24px auto;
            position: relative;
        }

        .ticket-card-header {
            background-color: var(--ds-primary);
            color: #FFFFFF;
            padding: 24px;
            text-align: center;
        }

        .ticket-divider {
            position: relative;
            height: 1px;
            border-top: 2px dashed var(--ds-border);
            margin: 0;
            background: transparent;
        }

        .ticket-divider::before, .ticket-divider::after {
            content: '';
            position: absolute;
            top: -12px;
            width: 24px;
            height: 24px;
            background-color: var(--ds-bg);
            border-radius: 50%;
        }

        .ticket-divider::before { left: -13px; border-right: 1px solid var(--ds-border); }
        .ticket-divider::after { right: -13px; border-left: 1px solid var(--ds-border); }

        .ticket-card-body {
            padding: 24px;
        }

        .ticket-meta-label {
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--ds-text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .ticket-meta-val {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--ds-text-primary);
        }

        @media print {
            body { background: #FFFFFF; padding: 0; }
            .btn-print-hide { display: none !important; }
            .ticket-card-digital { box-shadow: none; border-color: #000; }
        }
    </style>
</head>
<body>

    <div class="container" style="max-width: 520px;">
        
        <!-- Header Banner -->
        <div class="text-center mb-4">
            <span class="ds-badge ds-badge-success mb-2">
                <i class="fas fa-check-circle me-1"></i> BOOKING CONFIRMED
            </span>
            <h1 class="ds-title-hero mb-1">You're All Set!</h1>
            <p class="ds-text-body">Show your ticket QR pass at the entrance for verification.</p>
        </div>

        <!-- Loop for Individual Digital Pass Cards -->
        <% tickets.forEach(function(t, idx) { %>
            <div class="ticket-card-digital">
                <!-- Top Pass Header -->
                <div class="ticket-card-header">
                    <div class="ds-text-sm text-white-50 text-uppercase fw-bold tracking-wider mb-1">
                        Individual Pass <%= idx + 1 %> of <%= tickets.length %>
                    </div>
                    <div class="font-mono fw-extrabold fs-4 tracking-tight"><%= t.ticketNumber %></div>
                </div>

                <div class="ticket-card-body text-center">
                    <!-- Prominent Clean QR Code -->
                    <div class="ds-qr-container mb-3">
                        <img src="<%= t.qrDataUri %>" alt="Ticket QR Code" style="width: 220px; height: 220px;">
                    </div>

                    <div class="d-flex align-items-center justify-content-center gap-2 mb-4 btn-print-hide flex-wrap">
                        <div class="ds-text-sm fw-bold text-dark me-2">
                            <i class="fas fa-qrcode me-1"></i> Scan at venue entrance
                        </div>
                        <button onclick="window.print()" class="btn btn-sm btn-outline-dark rounded-pill px-3 py-1 fw-bold">
                            <i class="fas fa-download me-1 text-danger"></i> Download PDF
                        </button>
                    </div>

                    <!-- Ticket Details Grid -->
                    <div class="row g-3 text-start pt-3 border-top">
                        <div class="col-6">
                            <div class="ticket-meta-label">Event Name</div>
                            <div class="ticket-meta-val"><%= event.name %></div>
                        </div>
                        <div class="col-6">
                            <div class="ticket-meta-label">Attendee Name</div>
                            <div class="ticket-meta-val"><%= t.customerName %></div>
                        </div>
                        <div class="col-6">
                            <div class="ticket-meta-label">Event Date</div>
                            <div class="ticket-meta-val"><%= new Date(event.eventDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></div>
                        </div>
                        <div class="col-6">
                            <div class="ticket-meta-label">Time</div>
                            <div class="ticket-meta-val"><%= event.eventTime %></div>
                        </div>
                        <div class="col-6">
                            <div class="ticket-meta-label">Pass Quantity</div>
                            <div class="ticket-meta-val"><%= booking.quantity %> Ticket(s)</div>
                        </div>
                        <div class="col-6">
                            <div class="ticket-meta-label">Booked Date & Time</div>
                            <div class="ticket-meta-val"><%= new Date(booking.createdAt).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: true }) %></div>
                        </div>
                        <div class="col-12">
                            <div class="ticket-meta-label">Venue Location</div>
                            <div class="ticket-meta-val"><%= event.venue %></div>
                        </div>
                    </div>
                </div>

                <div class="ticket-divider"></div>

                <!-- Footer details -->
                <div class="px-4 py-3 bg-light d-flex justify-content-between align-items-center ds-text-sm">
                    <span><i class="fas fa-receipt me-1"></i> Booking ID: <strong><%= booking.bookingId %></strong></span>
                    <span>Status: <strong class="<%= booking.bookingStatus === 'CONFIRMED' ? 'text-success' : 'text-warning' %>"><%= booking.bookingStatus || 'CONFIRMED' %></strong></span>
                </div>
            </div>
        <% }); %>

        <!-- Print / PDF Download Action Buttons -->
        <div class="text-center btn-print-hide mb-4">
            <button onclick="window.print()" class="ds-btn ds-btn-primary w-100 py-3 mb-2">
                <i class="fas fa-file-pdf me-2"></i> Download / Print Digital Passes (PDF)
            </button>
            <div class="ds-text-sm">
                Tip: Click "Download / Print" and select "Save as PDF", take a screenshot, or keep this page open on your phone.
            </div>
        </div>
    </div>

</body>
</html>

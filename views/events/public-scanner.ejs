<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= scannerLink.name %> - Gate Scanner - <%= event.name %></title>
    
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Event Design System CSS -->
    <link rel="stylesheet" href="/css/event-design-system.css">

    <style>
        body {
            background-color: var(--ds-bg);
            padding-bottom: 24px;
        }

        .scanner-header-bar {
            background-color: #FFFFFF;
            border-bottom: 1px solid var(--ds-border);
            padding: 16px 20px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .camera-viewport-container {
            position: relative;
            background: #000000;
            border-radius: var(--ds-radius-lg);
            overflow: hidden;
            border: 1px solid var(--ds-border);
            min-height: 260px;
        }

        #qr-reader {
            width: 100%;
            border: none !important;
        }

        #qr-reader video {
            object-fit: cover !important;
            border-radius: var(--ds-radius-lg);
        }

        /* Subtle Scanning Overlay Guidelines */
        .scan-overlay-frame {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 200px;
            height: 200px;
            border: 2px dashed rgba(255, 255, 255, 0.6);
            border-radius: 16px;
            pointer-events: none;
            z-index: 10;
        }

        .scan-result-panel {
            border-radius: var(--ds-radius-lg);
            padding: 24px;
            text-align: center;
            animation: slideUp 0.15s ease-out;
        }

        .panel-approved { background-color: var(--ds-success-bg); border: 1px solid var(--ds-success-border); color: var(--ds-success-text); }
        .panel-already-used { background-color: var(--ds-warning-bg); border: 1px solid var(--ds-warning-border); color: var(--ds-warning-text); }
        .panel-wrong-event { background-color: var(--ds-danger-bg); border: 1px solid var(--ds-danger-border); color: var(--ds-danger-text); }
        .panel-invalid { background-color: var(--ds-danger-bg); border: 1px solid var(--ds-danger-border); color: var(--ds-danger-text); }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <!-- Compact Professional Scanner Header Bar -->
    <div class="scanner-header-bar">
        <div class="container p-0" style="max-width: 500px;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="ds-text-sm text-uppercase fw-bold text-muted"><%= event.name %></div>
                    <h1 class="fs-5 fw-extrabold text-dark m-0"><%= scannerLink.name %></h1>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span id="networkStatusBadge" class="ds-badge ds-badge-success">
                        <i class="fas fa-circle fs-8 text-success me-1"></i> Online
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Mobile Viewport Container -->
    <div class="container mt-3" style="max-width: 500px;">
        
        <!-- Compact Stats Cards -->
        <div class="row g-2 mb-3">
            <div class="col-6">
                <div class="ds-card-flat p-2 text-center">
                    <div class="ds-text-sm">Checked In</div>
                    <div class="fw-extrabold fs-5 text-dark mt-1" id="scannedCountVal"><%= checkedInCount %></div>
                </div>
            </div>
            <div class="col-6">
                <div class="ds-card-flat p-2 text-center">
                    <div class="ds-text-sm">Gate Pass</div>
                    <div class="fw-bold fs-7 text-truncate mt-1" title="<%= scannerLink.name %>"><%= scannerLink.gateNumber || 'Gate 1' %></div>
                </div>
            </div>
        </div>

        <!-- Scanner Card Container -->
        <div class="ds-card p-3 mb-3">
            <!-- Camera Viewport Area -->
            <div class="camera-viewport-container">
                <div id="qr-reader"></div>
                <div class="scan-overlay-frame"></div>
            </div>

            <!-- Compact Camera Controls -->
            <div class="d-flex justify-content-center gap-2 mt-3">
                <button id="btnStartScan" onclick="startCameraScanner()" class="ds-btn ds-btn-primary py-2 px-3 fs-7">
                    <i class="fas fa-play me-1"></i> Start Camera
                </button>
                <button id="btnStopScan" onclick="stopCameraScanner()" class="ds-btn ds-btn-secondary py-2 px-3 fs-7" disabled>
                    <i class="fas fa-stop me-1"></i> Pause Camera
                </button>
            </div>

            <!-- Validation Result Panel Container -->
            <div id="resultDisplayPanel" class="mt-3 d-none"></div>

            <!-- Manual Search Drawer Input -->
            <div class="mt-3 pt-3 border-top">
                <label class="ds-label mb-1">Manual Ticket # Search</label>
                <div class="input-group input-group-sm">
                    <input type="text" id="manualTokenInput" class="ds-input font-mono form-control" placeholder="Enter JJO-2026-XXXXXX">
                    <button class="ds-btn ds-btn-primary py-2 px-3 fs-7" onclick="processScannedToken(document.getElementById('manualTokenInput').value)">Verify</button>
                </div>
            </div>
        </div>
    </div>

    <!-- HTML5 QR Code Library -->
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

    <script>
        let html5QrCode = null;
        let isScanning = false;
        let isProcessing = false;
        let scansCount = parseInt('<%= todayScansCount %>') || 0;

        let isScannerDisabled = '<%= scannerLink.status %>' === 'DISABLED';

        // Auto-start camera scanner on page load if active
        window.addEventListener('load', function() {
            if (!isScannerDisabled) {
                setTimeout(() => {
                    startCameraScanner();
                }, 400);
            } else {
                renderResultPanel({ status: 'DISABLED', title: '✕ SCANNER PAUSED', message: 'This scanner link is currently paused by event administration.' });
            }
        });

        async function startCameraScanner() {
            if (isScanning || isScannerDisabled) return;

            const btnStart = document.getElementById('btnStartScan');
            const btnStop = document.getElementById('btnStopScan');
            btnStart.disabled = true;

            try {
                if (html5QrCode) {
                    try { await html5QrCode.stop(); } catch(e) {}
                    html5QrCode = null;
                }

                html5QrCode = new Html5Qrcode("qr-reader");
                const config = { fps: 10, qrbox: { width: 220, height: 220 } };

                try {
                    await html5QrCode.start({ facingMode: "environment" }, config, onScanSuccess, onScanError);
                } catch (envErr) {
                    console.warn("Back camera unavailable, trying default user camera:", envErr);
                    await html5QrCode.start({ facingMode: "user" }, config, onScanSuccess, onScanError);
                }

                isScanning = true;
                btnStart.disabled = true;
                btnStop.disabled = false;
            } catch (err) {
                console.error('Camera start error:', err);
                isScanning = false;
                if (!isScannerDisabled) btnStart.disabled = false;
                btnStop.disabled = true;
                alert('Unable to access camera: ' + (err.message || err));
            }
        }

        async function stopCameraScanner() {
            if (!html5QrCode) return;
            const btnStart = document.getElementById('btnStartScan');
            const btnStop = document.getElementById('btnStopScan');

            try {
                await html5QrCode.stop();
            } catch (e) {}

            isScanning = false;
            html5QrCode = null;
            if (!isScannerDisabled) btnStart.disabled = false;
            btnStop.disabled = true;
        }

        function onScanSuccess(decodedText) {
            if (isProcessing) return;
            isProcessing = true;
            playBeepSound();

            processScannedToken(decodedText);

            setTimeout(() => {
                isProcessing = false;
            }, 2500);
        }

        function onScanError(error) {}

        async function processScannedToken(token) {
            if (!token || !token.trim()) return;

            const panel = document.getElementById('resultDisplayPanel');
            panel.classList.remove('d-none');
            panel.className = 'scan-result-panel bg-white border text-dark';
            panel.innerHTML = `
                <div class="py-2">
                    <div class="spinner-border spinner-border-sm text-dark me-2" role="status"></div>
                    <span class="fw-bold ds-text-body">Verifying Pass...</span>
                </div>
            `;

            if (!navigator.onLine) {
                renderOfflineError();
                return;
            }

            try {
                const response = await fetch('/scan/event/<%= scannerLink.token %>/validate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ticketToken: token.trim(), deviceInfo: 'Mobile Camera' })
                });

                const data = await response.json();
                renderResultPanel(data);

            } catch (err) {
                renderOfflineError();
            }
        }

        function renderOfflineError() {
            renderResultPanel({
                status: 'NO_INTERNET',
                title: 'NO INTERNET CONNECTION',
                message: 'Ticket verification requires an active internet connection. Please reconnect and try again.'
            });
        }

        function renderResultPanel(data) {
            const panel = document.getElementById('resultDisplayPanel');
            panel.classList.remove('d-none');

            // Immediately update Checked In count from server authoritative stats response
            if (data && data.stats && typeof data.stats.checkedIn === 'number') {
                const countElem = document.getElementById('scannedCountVal');
                if (countElem) countElem.textContent = data.stats.checkedIn;
            }

            if (data.status === 'APPROVED') {
                panel.className = 'scan-result-panel panel-approved';
                panel.innerHTML = `
                    <div class="fs-2 mb-1"><i class="fas fa-check-circle"></i></div>
                    <h3 class="fw-extrabold fs-4 m-0">${data.title}</h3>
                    <div class="ds-text-sm fw-bold mb-3">${data.eventName}</div>

                    <div class="bg-white text-dark p-3 rounded-3 text-start mb-2 border">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="ds-text-sm">Ticket #:</span>
                            <span class="fw-extrabold font-mono text-dark">${data.ticketNumber}</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="ds-text-sm">Attendee:</span>
                            <span class="fw-bold">${data.customerName}</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="ds-text-sm">Pass Quantity:</span>
                            <span class="fw-bold">${data.quantity || 1} Ticket(s)</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="ds-text-sm">Gate:</span>
                            <span class="fw-bold">${data.gate}</span>
                        </div>
                    </div>

                    <div class="fw-bold fs-6"><i class="fas fa-user-check me-1"></i> ENTRY APPROVED (${data.entryTime})</div>
                `;
            } else if (data.status === 'ALREADY_CHECKED_IN') {
                panel.className = 'scan-result-panel panel-already-used';
                panel.innerHTML = `
                    <div class="fs-2 mb-1"><i class="fas fa-exclamation-triangle"></i></div>
                    <h3 class="fw-extrabold fs-4 m-0">${data.title}</h3>
                    <div class="ds-text-sm fw-bold mb-3">Ticket already used! Do NOT count again.</div>

                    <div class="bg-white text-dark p-3 rounded-3 text-start mb-2 border">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="ds-text-sm">Ticket #:</span>
                            <span class="fw-bold font-mono">${data.ticketNumber}</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="ds-text-sm">Attendee:</span>
                            <span class="fw-bold">${data.customerName}</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="ds-text-sm">Pass Quantity:</span>
                            <span class="fw-bold">${data.quantity || 1} Ticket(s)</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="ds-text-sm">Checked In At:</span>
                            <span class="fw-bold text-danger">${data.checkedInAt} (${data.checkedInGate || 'Gate 1'})</span>
                        </div>
                    </div>

                    <div class="fw-bold fs-6 text-danger"><i class="fas fa-ban me-1"></i> REJECT DUPLICATE</div>
                `;
            } else if (data.status === 'WRONG_EVENT') {
                panel.className = 'scan-result-panel panel-wrong-event';
                panel.innerHTML = `
                    <div class="fs-2 mb-1"><i class="fas fa-hand-paper"></i></div>
                    <h3 class="fw-extrabold fs-4 m-0">${data.title}</h3>
                    <div class="ds-text-sm fw-bold mb-3">Ticket belongs to another event!</div>

                    <div class="bg-white text-dark p-3 rounded-3 text-start mb-2 border">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="ds-text-sm">Ticket Belongs To:</span>
                            <span class="fw-extrabold text-danger">${data.ticketEventName}</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="ds-text-sm">Current Gate Event:</span>
                            <span class="fw-bold">${data.eventName}</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="ds-text-sm">Attendee:</span>
                            <span class="fw-bold">${data.customerName} (${data.ticketNumber})</span>
                        </div>
                    </div>

                    <div class="fw-bold fs-6"><i class="fas fa-times-circle me-1"></i> ENTRY REJECTED</div>
                `;
            } else if (data.status === 'ACTIVE_RESUMED') {
                panel.className = 'scan-result-panel panel-approved';
                panel.innerHTML = `
                    <div class="fs-2 mb-1"><i class="fas fa-check-circle text-success"></i></div>
                    <h3 class="fw-extrabold fs-4 m-0 text-success">${data.title || '✓ SCANNER REACTIVATED'}</h3>
                    <p class="ds-text-sm mb-0 text-dark fw-bold">${data.message || 'Scanner link has been turned back ON by event administration. Camera ready.'}</p>
                `;
            } else if (data.status === 'DISABLED' || data.status === 'EXPIRED') {
                panel.className = 'scan-result-panel panel-invalid';
                panel.innerHTML = `
                    <div class="fs-2 mb-1"><i class="fas fa-lock text-danger"></i></div>
                    <h3 class="fw-extrabold fs-4 m-0 text-danger">${data.title || '✕ SCANNER DISABLED'}</h3>
                    <p class="ds-text-sm mb-0 text-muted fw-bold">${data.message || 'This scanner link has been paused or disabled.'}</p>
                `;
            } else if (data.status === 'NO_INTERNET') {
                panel.className = 'scan-result-panel panel-invalid';
                panel.innerHTML = `
                    <div class="fs-2 mb-1"><i class="fas fa-wifi-slash text-danger"></i></div>
                    <h3 class="fw-extrabold fs-4 m-0 text-danger">${data.title}</h3>
                    <p class="ds-text-sm mb-2 text-dark fw-bold">${data.message}</p>
                    <button class="btn btn-sm btn-outline-secondary mt-1 rounded-pill" onclick="processScannedToken(document.getElementById('manualTokenInput').value)">
                        <i class="fas fa-sync-alt me-1"></i> Retry Connection
                    </button>
                `;
            } else {
                panel.className = 'scan-result-panel panel-invalid';
                panel.innerHTML = `
                    <div class="fs-2 mb-1"><i class="fas fa-times-circle"></i></div>
                    <h3 class="fw-extrabold fs-4 m-0">${data.title}</h3>
                    <p class="ds-text-sm mb-0">${data.message}</p>
                `;
            }
        }

        window.addEventListener('online', function() {
            const badge = document.getElementById('networkStatusBadge');
            if (badge) badge.className = 'ds-badge ds-badge-success';
        });

        window.addEventListener('offline', function() {
            const badge = document.getElementById('networkStatusBadge');
            if (badge) badge.className = 'ds-badge ds-badge-danger';
        });

        function playBeepSound() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(880, ctx.currentTime);
                osc.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.1);
            } catch (e) {}
        }

        // Real-time WebSocket multi-scanner update & remote lockdown listener
        (function initWebSocketClient() {
            try {
                const wsProtocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
                const socket = new WebSocket(`${wsProtocol}//${window.location.host}`);

                socket.onopen = function() {
                    socket.send(JSON.stringify({ type: 'FETCH_EVENT_STATS', eventId: '<%= event._id %>' }));
                };

                socket.onmessage = function(event) {
                    try {
                        const data = JSON.parse(event.data);
                        if (data.type === 'ATTENDANCE_CHECKIN' && data.eventId === '<%= event._id %>') {
                            if (typeof data.checkedInTickets === 'number') {
                                const countElem = document.getElementById('scannedCountVal');
                                if (countElem) countElem.textContent = data.checkedInTickets;
                            }
                        } else if (data.type === 'SCANNER_STATUS_CHANGE' && data.scannerLinkId === '<%= scannerLink._id %>') {
                            if (data.status === 'DISABLED') {
                                isScannerDisabled = true;
                                stopCameraScanner();
                                renderResultPanel({ status: 'DISABLED', title: '✕ SCANNER PAUSED BY ADMIN', message: 'This scanner link was just paused by event administration.' });
                                document.getElementById('btnStartScan').disabled = true;
                            } else if (data.status === 'ACTIVE') {
                                isScannerDisabled = false;
                                document.getElementById('btnStartScan').disabled = false;
                                renderResultPanel({ status: 'ACTIVE_RESUMED', title: '✓ SCANNER REACTIVATED BY ADMIN', message: 'Scanner link has been turned back ON by administration. Starting camera...' });
                                setTimeout(() => {
                                    startCameraScanner();
                                }, 500);
                            }
                        } else if (data.type === 'SCANNER_DELETED' && data.scannerLinkId === '<%= scannerLink._id %>') {
                            isScannerDisabled = true;
                            stopCameraScanner();
                            renderResultPanel({ status: 'DISABLED', title: '✕ SCANNER DELETED', message: 'This scanner link has been deleted by event administration.' });
                            document.getElementById('btnStartScan').disabled = true;
                        } else if (data.type === 'EVENT_DELETED' && data.eventId === '<%= event._id %>') {
                            isScannerDisabled = true;
                            stopCameraScanner();
                            renderResultPanel({ status: 'DISABLED', title: '✕ EVENT DELETED', message: 'This event has been deleted from the system.' });
                            document.getElementById('btnStartScan').disabled = true;
                        }
                    } catch (e) {}
                };

                socket.onclose = function() {
                    setTimeout(initWebSocketClient, 3000);
                };
            } catch (err) {}
        })();
    </script>
</body>
</html>

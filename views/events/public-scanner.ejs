<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= scannerLink.name %> - Gate Scanner - <%= event.name %></title>
    
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Event Design System CSS -->
    <link rel="stylesheet" href="/css/event-design-system.css">

    <style>
        body {
            background-color: var(--ds-bg);
            padding-bottom: 24px;
        }

        .scanner-header-bar {
            background-color: #FFFFFF;
            border-bottom: 1px solid var(--ds-border);
            padding: 16px 20px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: var(--ds-shadow-sm);
        }

        .camera-viewport-container {
            position: relative;
            background: #000000;
            border-radius: var(--ds-radius-lg);
            overflow: hidden;
            border: 1px solid var(--ds-border);
            min-height: 260px;
        }

        #qr-reader {
            width: 100%;
            border: none !important;
        }

        #qr-reader video {
            object-fit: cover !important;
            border-radius: var(--ds-radius-lg);
        }

        .scan-overlay-frame {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 200px;
            height: 200px;
            border: 2px dashed rgba(255, 255, 255, 0.7);
            border-radius: 16px;
            pointer-events: none;
            z-index: 10;
        }

        .scan-result-panel {
            border-radius: var(--ds-radius-lg);
            padding: 20px;
            text-align: center;
            animation: slideUp 0.15s ease-out;
        }

        .panel-approved { background-color: var(--ds-success-bg); border: 1px solid var(--ds-success-border); color: var(--ds-success-text); }
        .panel-already-used { background-color: var(--ds-warning-bg); border: 1px solid var(--ds-warning-border); color: var(--ds-warning-text); }
        .panel-wrong-event { background-color: var(--ds-danger-bg); border: 1px solid var(--ds-danger-border); color: var(--ds-danger-text); }
        .panel-invalid { background-color: var(--ds-danger-bg); border: 1px solid var(--ds-danger-border); color: var(--ds-danger-text); }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <!-- Compact Professional Scanner Header Bar -->
    <div class="scanner-header-bar">
        <div class="container p-0" style="max-width: 500px;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="ds-text-sm text-uppercase fw-bold text-muted"><%= event.name %></div>
                    <h1 class="fs-5 fw-extrabold text-dark m-0"><%= scannerLink.name %></h1>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span id="networkStatusBadge" class="ds-badge ds-badge-success">
                        <i class="fas fa-circle fs-8 text-success me-1"></i> Online
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Mobile Viewport Container -->
    <div class="container mt-3" style="max-width: 500px;">
        
        <!-- Compact Stats Cards (Checked In & Gate Only) -->
        <div class="row g-2 mb-3">
            <div class="col-6">
                <div class="ds-card-flat p-2 text-center">
                    <div class="ds-text-sm text-uppercase fw-bold">Checked In</div>
                    <div class="fw-extrabold fs-5 text-dark mt-1" id="scannedCountVal"><%= checkedInCount %></div>
                </div>
            </div>
            <div class="col-6">
                <div class="ds-card-flat p-2 text-center">
                    <div class="ds-text-sm text-uppercase fw-bold">Gate Pass</div>
                    <div class="fw-bold fs-7 text-truncate mt-1" title="<%= scannerLink.name %>"><%= scannerLink.gateNumber || 'Gate 1' %></div>
                </div>
            </div>
        </div>

        <!-- Scanner Card Container -->
        <div class="ds-card p-3 mb-3">
            <!-- Camera Viewport Area -->
            <div class="camera-viewport-container">
                <div id="qr-reader"></div>
                <div class="scan-overlay-frame"></div>
            </div>

            <!-- Compact Camera Controls -->
            <div class="d-flex justify-content-center gap-2 mt-3">
                <button id="btnStartScan" onclick="startCameraScanner()" class="ds-btn ds-btn-primary py-2 px-3 fs-7">
                    <i class="fas fa-play me-1"></i> Start Camera
                </button>
                <button id="btnStopScan" onclick="stopCameraScanner()" class="ds-btn ds-btn-secondary py-2 px-3 fs-7" disabled>
                    <i class="fas fa-stop me-1"></i> Pause Camera
                </button>
            </div>

            <!-- Validation Result Panel Container -->
            <div id="resultDisplayPanel" class="mt-3 d-none"></div>

            <!-- Manual Search Input -->
            <div class="mt-3 pt-3 border-top">
                <label class="ds-label mb-1">Manual Ticket # Search</label>
                <div class="input-group input-group-sm">
                    <input type="text" id="manualTokenInput" class="ds-input font-mono form-control" placeholder="e.g. JJO-2026-000001">
                    <button class="ds-btn ds-btn-primary py-2 px-3 fs-7" onclick="processScannedToken(document.getElementById('manualTokenInput').value)">Verify</button>
                </div>
            </div>
        </div>

        <div class="text-center">
            <div class="d-inline-flex align-items-center gap-1 px-3 py-1 rounded-pill bg-white border shadow-sm">
                <span class="fs-8 text-muted fw-bold">Made with <span style="color: #e25555;">❤️</span> by <strong class="text-dark">Vijay</strong></span>
            </div>
        </div>
    </div>

    <!-- HTML5 QR Code Library -->
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

    <script>
        let html5QrCode = null;
        let isScanning = false;
        let isProcessing = false;
        let isScannerDisabled = '<%= scannerLink.status %>' === 'DISABLED';

        // Auto-start camera scanner on page load if active
        window.addEventListener('load', function() {
            if (!isScannerDisabled) {
                setTimeout(() => {
                    startCameraScanner();
                }, 400);
            } else {
                renderResultPanel({ status: 'DISABLED', title: '✕ SCANNER PAUSED', message: 'This scanner link is currently paused by event administration.' });
            }
        });

        async function startCameraScanner() {
            if (isScanning || isScannerDisabled) return;

            const btnStart = document.getElementById('btnStartScan');
            const btnStop = document.getElementById('btnStopScan');
            btnStart.disabled = true;

            try {
                if (html5QrCode) {
                    try { await html5QrCode.stop(); } catch(e) {}
                    html5QrCode = null;
                }

                html5QrCode = new Html5Qrcode("qr-reader");
                const config = { fps: 10, qrbox: { width: 220, height: 220 } };

                try {
                    await html5QrCode.start({ facingMode: "environment" }, config, onScanSuccess, onScanError);
                } catch (envErr) {
                    console.warn("Back camera unavailable, trying default user camera:", envErr);
                    await html5QrCode.start({ facingMode: "user" }, config, onScanSuccess, onScanError);
                }

                isScanning = true;
                btnStart.disabled = true;
                btnStop.disabled = false;

            } catch (err) {
                console.error("Camera access error:", err);
                btnStart.disabled = false;
                alert("Camera permission denied or camera not found on device.");
            }
        }

        async function stopCameraScanner() {
            const btnStart = document.getElementById('btnStartScan');
            const btnStop = document.getElementById('btnStopScan');

            if (html5QrCode && isScanning) {
                try {
                    await html5QrCode.stop();
                } catch(e) {}
                isScanning = false;
                html5QrCode = null;
            }

            btnStart.disabled = false;
            btnStop.disabled = true;
        }

        function onScanError(errorMessage) {
            // Ignore frame scan failures
        }

        async function onScanSuccess(decodedText, decodedResult) {
            if (isProcessing) return;
            isProcessing = true;

            try {
                if (navigator.vibrate) navigator.vibrate([100, 50, 100]);
            } catch(e) {}

            await processScannedToken(decodedText);

            setTimeout(() => {
                isProcessing = false;
            }, 1800);
        }

        async function processScannedToken(tokenVal) {
            if (!tokenVal || !tokenVal.trim()) return;

            if (!navigator.onLine) {
                renderResultPanel({
                    status: 'OFFLINE',
                    title: 'NO INTERNET CONNECTION',
                    message: 'Ticket verification requires an active internet connection. Please check network and retry.'
                });
                return;
            }

            try {
                const res = await fetch(`/scan/event/<%= scannerLink.token %>/validate`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ticketToken: tokenVal.trim() })
                });

                const data = await res.json();
                renderResultPanel(data);

                if (data.stats && typeof data.stats.checkedIn !== 'undefined') {
                    const countEl = document.getElementById('scannedCountVal');
                    if (countEl) countEl.textContent = data.stats.checkedIn;
                }

                document.getElementById('manualTokenInput').value = '';

            } catch (err) {
                console.error("Scan validation error:", err);
                renderResultPanel({
                    status: 'ERROR',
                    title: '✕ CONNECTION ERROR',
                    message: 'Server error validating ticket scan. Please try again.'
                });
            }
        }

        function renderResultPanel(res) {
            const panel = document.getElementById('resultDisplayPanel');
            panel.classList.remove('d-none');

            let cssClass = 'panel-invalid';
            let icon = 'fa-times-circle';

            if (res.status === 'APPROVED' || res.status === 'VALID') {
                cssClass = 'panel-approved';
                icon = 'fa-check-circle';
            } else if (res.status === 'ALREADY_CHECKED_IN' || res.status === 'ALREADY_USED') {
                cssClass = 'panel-already-used';
                icon = 'fa-exclamation-triangle';
            } else if (res.status === 'WRONG_EVENT') {
                cssClass = 'panel-wrong-event';
                icon = 'fa-hand-paper';
            }

            panel.className = `scan-result-panel ${cssClass} mt-3`;

            panel.innerHTML = `
                <div class="fs-1 mb-2"><i class="fas ${icon}"></i></div>
                <h4 class="fw-extrabold mb-1">${res.title || res.message}</h4>
                ${res.customerName ? `<div class="fw-bold fs-5 mt-1">${res.customerName}</div>` : ''}
                ${res.ticketNumber ? `<div class="font-mono fw-bold fs-6 mt-1">Ticket: ${res.ticketNumber}</div>` : ''}
                ${res.entryTime ? `<div class="fs-7 mt-1">Entry Time: ${res.entryTime}</div>` : ''}
                ${res.gate ? `<div class="fs-7 mt-1">Gate: ${res.gate}</div>` : ''}
                <div class="fs-7 mt-2">${res.message || ''}</div>
            `;

            panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Tickets - <%= event.name %></title>
    
    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Event Design System CSS -->
    <link rel="stylesheet" href="/css/event-design-system.css">

    <style>
        .meta-icon-box {
            width: 38px;
            height: 38px;
            border-radius: var(--ds-radius-sm);
            background-color: var(--ds-surface-subtle);
            color: var(--ds-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
            flex-shrink: 0;
            border: 1px solid var(--ds-border-subtle);
        }

        .sticky-checkout-card {
            position: sticky;
            top: 24px;
        }

        @media (max-width: 991px) {
            .sticky-checkout-card {
                position: static;
            }
        }
    </style>
</head>
<body>

    <div class="ds-container">
        
        <!-- Public Brand Subtitle Header -->
        <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
            <div class="d-flex align-items-center gap-2 text-dark font-weight-bold">
                <i class="fas fa-ticket-alt text-primary fs-5"></i>
                <span class="fw-bold tracking-tight text-uppercase fs-7 text-muted">Official Event Ticketing</span>
            </div>
            <div>
                <% if (event.ticketPrice === 0) { %>
                    <span class="ds-badge ds-badge-success"><i class="fas fa-check-circle"></i> FREE ENTRY</span>
                <% } else { %>
                    <span class="ds-badge ds-badge-neutral"><i class="fas fa-tag"></i> ₹<%= event.ticketPrice %> / Ticket</span>
                <% } %>
            </div>
        </div>

        <div class="row g-4">
            <!-- Left Column: Event Information (60%) -->
            <div class="col-lg-7">
                <!-- Event Banner Image if available or clean placeholder -->
                <% if (event.bannerImage) { %>
                    <div class="event-banner-wrapper">
                        <img src="<%= event.bannerImage %>" alt="<%= event.name %>" class="event-banner-img">
                    </div>
                <% } else { %>
                    <div class="event-banner-placeholder">
                        <i class="fas fa-calendar-star fs-1 mb-2 text-white-50"></i>
                        <h3 class="fw-bold m-0"><%= event.name %></h3>
                        <span class="fs-8 text-white-50"><%= event.venue %></span>
                    </div>
                <% } %>

                <h1 class="ds-title-hero mb-3"><%= event.name %></h1>

                <!-- Event Details Grid -->
                <div class="ds-card-flat mb-4">
                    <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom">
                        <div class="meta-icon-box"><i class="far fa-calendar-alt"></i></div>
                        <div>
                            <div class="ds-text-sm text-uppercase fw-bold">Date</div>
                            <div class="fw-bold text-dark fs-6"><%= formatISTDate(event.eventDate, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom">
                        <div class="meta-icon-box"><i class="far fa-clock"></i></div>
                        <div>
                            <div class="ds-text-sm text-uppercase fw-bold">Time</div>
                            <div class="fw-bold text-dark fs-6"><%= event.eventTime %> IST</div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <div class="meta-icon-box"><i class="fas fa-map-marker-alt"></i></div>
                        <div>
                            <div class="ds-text-sm text-uppercase fw-bold">Venue Location</div>
                            <div class="fw-bold text-dark fs-6"><%= event.venue %></div>
                        </div>
                    </div>
                </div>

                <!-- Ticket Availability Status Card -->
                <div class="ds-card-flat mb-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="ds-text-sm text-uppercase fw-bold">Tickets Available</div>
                            <div class="fw-extrabold fs-4 text-dark mt-1">
                                <%= event.remainingTickets.toLocaleString() %> <span class="fs-7 text-muted fw-normal">of <%= event.totalTickets.toLocaleString() %> available</span>
                            </div>
                        </div>
                        <div>
                            <% if (event.bookingStatus === 'SOLD_OUT' || event.remainingTickets <= 0) { %>
                                <span class="ds-badge ds-badge-danger"><i class="fas fa-ban me-1"></i> SOLD OUT</span>
                            <% } else if (event.bookingStatus !== 'OPEN') { %>
                                <span class="ds-badge ds-badge-warning"><i class="fas fa-pause-circle me-1"></i> BOOKING <%= event.bookingStatus %></span>
                            <% } else { %>
                                <span class="ds-badge ds-badge-success"><i class="fas fa-check-circle me-1"></i> BOOKING OPEN</span>
                            <% } %>
                        </div>
                    </div>
                </div>

                <% if (event.description) { %>
                    <div class="ds-card-flat mb-4">
                        <div class="ds-text-sm text-uppercase fw-bold mb-2"><i class="fas fa-align-left me-1"></i> About the Event</div>
                        <div class="ds-text-body" style="white-space: pre-line;"><%= event.description %></div>
                    </div>
                <% } %>
            </div>

            <!-- Right Column: Clean Checkout Panel (40%) -->
            <div class="col-lg-5">
                <div class="ds-card sticky-checkout-card">
                    <h2 class="ds-title-section mb-4"><i class="fas fa-ticket-alt text-primary me-2"></i>Book Your Tickets</h2>

                    <div id="alertContainer"></div>

                    <% if (event.bookingStatus === 'OPEN' && event.remainingTickets > 0) { %>
                        <form id="publicBookingForm">
                            <!-- Quantity Selector -->
                            <div class="ds-form-group">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="ds-label m-0">Number of Tickets</label>
                                    <span class="ds-text-sm">Limit: <%= event.maxTicketsPerBooking %> / booking</span>
                                </div>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="ds-stepper">
                                        <button type="button" class="ds-stepper-btn" id="btnMinus" onclick="updateQty(-1)">−</button>
                                        <input type="number" id="ticketQty" name="quantity" class="ds-stepper-val" value="<%= event.minTicketsPerBooking %>" min="<%= event.minTicketsPerBooking %>" max="<%= Math.min(event.maxTicketsPerBooking, event.remainingTickets) %>" oninput="handleDirectQtyInput(this)" onchange="handleDirectQtyInput(this)">
                                        <button type="button" class="ds-stepper-btn" id="btnPlus" onclick="updateQty(1)">+</button>
                                    </div>
                                    <div class="ds-text-sm text-muted">
                                        Passes
                                    </div>
                                </div>
                                <div id="qtyInputHint" class="ds-text-sm text-danger mt-1 d-none"></div>
                            </div>

                            <!-- Customer Info Inputs -->
                            <div class="ds-form-group">
                                <label for="customerName" class="ds-label">Full Name <span class="text-danger">*</span></label>
                                <input type="text" class="ds-input" id="customerName" name="customerName" placeholder="e.g. Vijay Mudaliyar" required>
                            </div>

                            <div class="ds-form-group">
                                <label for="customerMobile" class="ds-label">Mobile Number <span class="text-danger">*</span></label>
                                <input type="tel" class="ds-input" id="customerMobile" name="customerMobile" placeholder="10-digit mobile number" pattern="[0-9]{10}" required>
                            </div>

                            <div class="ds-form-group">
                                <label for="customerEmail" class="ds-label">Email Address <%= event.requireEmail ? '<span class="text-danger">*</span>' : '(Optional)' %></label>
                                <input type="email" class="ds-input" id="customerEmail" name="customerEmail" placeholder="name@example.com" <%= event.requireEmail ? 'required' : '' %>>
                            </div>

                            <!-- Price Summary Box -->
                            <div class="p-3 bg-light rounded-3 mb-4 border">
                                <div class="d-flex justify-content-between ds-text-body mb-2">
                                    <span>Ticket Price</span>
                                    <span class="fw-bold text-dark"><%= event.ticketPrice === 0 ? 'FREE' : '₹' + event.ticketPrice %></span>
                                </div>
                                <div class="d-flex justify-content-between ds-text-body mb-2">
                                    <span>Quantity</span>
                                    <span class="fw-bold text-dark" id="summaryQty"><%= event.minTicketsPerBooking %></span>
                                </div>
                                <div class="d-flex justify-content-between fs-6 pt-2 border-top">
                                    <span class="fw-bold text-dark">Total Amount</span>
                                    <span class="fw-bold text-dark" id="summaryTotal"><%= event.ticketPrice === 0 ? 'FREE ENTRY' : '₹' + (event.ticketPrice * event.minTicketsPerBooking) %></span>
                                </div>
                            </div>

                            <button type="submit" class="ds-btn ds-btn-primary w-100 py-3" id="submitBookingBtn">
                                <span id="btnText"><%= event.ticketPrice === 0 ? 'Confirm Booking' : 'Book ' + event.minTicketsPerBooking + ' Tickets — ₹' + (event.ticketPrice * event.minTicketsPerBooking) %></span>
                            </button>
                        </form>
                    <% } else { %>
                        <div class="text-center py-5">
                            <div class="fs-1 text-muted mb-2"><i class="fas fa-lock"></i></div>
                            <h4 class="fw-bold text-dark">Booking Unavailable</h4>
                            <p class="ds-text-body mb-4">Tickets for this event are currently sold out or closed.</p>
                            <button class="ds-btn ds-btn-secondary w-100" disabled>SOLD OUT</button>
                        </div>
                    <% } %>

                    <div class="text-center ds-text-sm mt-3 pt-3 border-top">
                        <i class="fas fa-shield-alt text-primary me-1"></i> Instant Digital Pass & Verified Entry
                    </div>

                    <!-- Made with love badge -->
                    <div class="text-center mt-3">
                        <div class="d-inline-flex align-items-center gap-1 px-3 py-1 rounded-pill bg-light border">
                            <span class="fs-8 text-muted fw-bold">Made with <span style="color: #e25555;">❤️</span> by <strong class="text-dark">Vijay</strong></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const minQty = parseInt('<%= event.minTicketsPerBooking %>') || 1;
        const maxQtyLimit = parseInt('<%= event.maxTicketsPerBooking %>') || 200;
        let availableCapacity = parseInt('<%= event.remainingTickets %>') || 0;
        const unitPrice = parseFloat('<%= event.ticketPrice %>') || 0;

        function updateQty(change) {
            const input = document.getElementById('ticketQty');
            let currentVal = parseInt(input.value) || minQty;
            input.value = currentVal + change;
            handleDirectQtyInput(input);
        }

        function handleDirectQtyInput(input) {
            let val = parseInt(input.value);
            const hint = document.getElementById('qtyInputHint');
            const maxAllowed = Math.min(maxQtyLimit, availableCapacity);

            if (isNaN(val) || val < minQty) {
                if (hint) {
                    hint.textContent = `Minimum ${minQty} ticket required per booking.`;
                    hint.classList.remove('d-none');
                }
                document.getElementById('summaryQty').textContent = input.value || minQty;
                return;
            }

            if (val > maxAllowed) {
                val = maxAllowed;
                input.value = maxAllowed;
                if (hint) {
                    hint.textContent = `Maximum limit is ${maxAllowed} ticket(s).`;
                    hint.classList.remove('d-none');
                }
            } else {
                if (hint) hint.classList.add('d-none');
            }

            // Update summary
            document.getElementById('summaryQty').textContent = val;
            const total = unitPrice * val;
            const totalText = unitPrice === 0 ? 'FREE ENTRY' : '₹' + total.toLocaleString('en-IN');
            document.getElementById('summaryTotal').textContent = totalText;

            const btnText = document.getElementById('btnText');
            if (btnText) {
                btnText.textContent = unitPrice === 0 ? 'Confirm Booking' : `Book ${val} Ticket(s) — ₹${total.toLocaleString('en-IN')}`;
            }

            const btnMinus = document.getElementById('btnMinus');
            const btnPlus = document.getElementById('btnPlus');
            if (btnMinus) btnMinus.disabled = (val <= minQty);
            if (btnPlus) btnPlus.disabled = (val >= maxAllowed);
        }

        document.getElementById('publicBookingForm')?.addEventListener('submit', async function(e) {
            e.preventDefault();

            const btn = document.getElementById('submitBookingBtn');
            const btnText = document.getElementById('btnText');
            const alertContainer = document.getElementById('alertContainer');
            alertContainer.innerHTML = '';

            const customerName = document.getElementById('customerName').value.trim();
            const customerMobile = document.getElementById('customerMobile').value.trim();
            const customerEmail = document.getElementById('customerEmail').value.trim();
            const quantity = parseInt(document.getElementById('ticketQty').value, 10);

            if (!customerName || !customerMobile || isNaN(quantity)) {
                alertContainer.innerHTML = `<div class="alert alert-danger py-2 px-3 rounded-3 fs-7 mb-3">Please fill out all required fields.</div>`;
                return;
            }

            btn.disabled = true;
            btnText.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status"></span> Processing Booking...`;

            try {
                const response = await fetch('/events/<%= event.slug %>/book', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ customerName, customerMobile, customerEmail, quantity })
                });

                const result = await response.json();

                if (result.success && result.redirectUrl) {
                    window.location.href = result.redirectUrl;
                } else {
                    alertContainer.innerHTML = `<div class="alert alert-danger py-2 px-3 rounded-3 fs-7 mb-3">${result.message || 'Booking failed. Please try again.'}</div>`;
                    btn.disabled = false;
                    handleDirectQtyInput(document.getElementById('ticketQty'));
                }
            } catch (err) {
                console.error('Booking submission error:', err);
                alertContainer.innerHTML = `<div class="alert alert-danger py-2 px-3 rounded-3 fs-7 mb-3">Connection error while booking. Please try again.</div>`;
                btn.disabled = false;
                handleDirectQtyInput(document.getElementById('ticketQty'));
            }
        });

        // Initialize state on load
        window.addEventListener('load', function() {
            const input = document.getElementById('ticketQty');
            if (input) handleDirectQtyInput(input);
        });
    </script>
</body>
</html>
